                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
 sh.Id_Postulacion as Id_Postulacion
 ,per.Nro_Documento as DNI_Usuario_Registra
 ,per.ApePaterno as Apellido_Paterno_Usuario_Registra
 ,per.ApeMaterno as Apellido_Materno_Usuario_Registra
 ,per.Nombres as Nombres_Usuario_Registra
 ,pea.ApePaterno as Apellido_Paterno_Usuario_Aprueba
 ,pea.ApeMaterno as Apellido_Materno_Usuario_Aprueba
 ,pea.Nombres as Nombres_Usuario_Aprueba
 ,sh.Id_Institucion_Inicio as Id_Institucion_Origen
 ,sh.Id_Sede_Inicio as Id_Sede_Origen
 ,sh.Id_Carrera_Inicio as Id_Carrera_Origen
 ,sh.Id_Institucion_Fin as Id_Institucion_Destino
 ,sh.Id_Sede_Fin as Id_Sede_Destino
 ,sh.Id_Carrera_Fin as Id_Carrera_Destino
 ,sh.Fecha_Reg as FechaRegistro
 ,sh.Fecha_Aprob
 ,sh.Nro_Resolucion
 ,sh.Fecha_Resolucion
 ,sh.Link_Resolucion
 ,sh.SemestreCambio
 ,sh.periodo_situacion
 ,sh.anio_situacion  
 from S_Historico_Carrera sh
 inner join Postulacion po on po.Id_Postulacion=sh.Id_Postulacion
 inner join Persona per on per.Id_Persona=sh.Id_Usuario_Reg
 left join Persona pea on pea.Id_Persona=sh.Id_Usuario_Aprob
 where Estado=1 order by Fecha_Reg desc</property>

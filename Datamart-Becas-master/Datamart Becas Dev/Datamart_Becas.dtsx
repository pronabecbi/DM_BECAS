                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT  [Id_Postulacion_Preadj]
      ,[Id_Institucion]
      ,isnull(UPPER([Nombre_Institucion]),'SIN REGISTRO') as [Nombre_Institucion] 
      ,isnull(UPPER([Nombre_Sede]),'SIN REGISTRO') as [Nombre_Sede] 
      ,isnull(UPPER([Nombre_Carrera]),'SIN REGISTRO') as [Nombre_Carrera] 
      ,[Regimen_Estudio]
	  ,isnull(UPPER([Rendimiento]),'SIN REGISTRO') as [Rendimiento] 
      ,isnull([Duracion],999999) as [Duracion]
      ,isnull([Matriculas],999999) as [Matriculas]
	  ,isnull(UPPER([Semestre]),'SIN REGISTRO') as [Semestre] 
  FROM [dm_becas].[sa].[Dim_Institucion_Origen]</property>

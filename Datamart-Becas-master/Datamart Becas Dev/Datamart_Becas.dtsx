            <component
              refId="Package\Carga_sa_Dim_Inscripcion_Esq_Ant_T1\Origen Inscripcion Transac T1"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen Inscripcion Transac T1"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
[Id_Postulacion_Preadj]= concat(1,pos.Id_Postulacion),
[Id_Persona] = pos.Id_Persona,
[Id_Convocatoria] = pos.Id_Convocatoria,
null as 'Id_Concurso',
null as 'Edad_Bases',
[Departamento_Reniec] = ur.Nom_Reg,
[Provincia_Reniec] = ur.Nom_Pro,
[Distrito_Reniec] = ur.Nom_Dis,
[Tipo_Pais_Inscripcion]=ISNULL(CASE WHEN hg.Codigo &lt; 26 THEN 'NACIONAL' ELSE 'INTERNACIONAL' END,'NO REGISTRADO'),
[Pais_Inscripcion]=ISNULL(CASE WHEN hg.Codigo &lt; 26 THEN 'PERU' ELSE hg.Descripcion END,'NO REGISTRADO'),
[Region_Inscripcion]=isnull(cast( hg.Descripcion  as varchar(200)),'NO REGISTRADO'), 
[Provincia_Inscripcion]=isnull(cast( ig.Descripcion  as varchar(200)),'NO REGISTRADO'),
[Distrito_Inscripcion]=isnull(cast( g.Descripcion  as varchar(200)),'NO REGISTRADO'),
[Flag_Vraem] = case when vr.Inc_VRAE = 1 then 'VRAEM' ELSE 'NO VRAEM' END,
[Estado_Inscripcion] = case when pos.flag_preinscripcion is null then IIF(pos.Id_Estado = 2679,'REGISTRO COMPLETO','EN PROCESO DE REGISTRO') else 'REGISTRO COMPLETO'END,
[Fecha_Inscripcion] =
case 
	when pos.Id_Convocatoria  in (243,244,245,246,247,248,249,250,255) then isnull(pos.Fec_modificacion,pos.Fec_Postulacion)
	when pos.Id_Convocatoria  in (278,279,283) then fecins.Fec_Postulacion
	else null
	end,
--[Fecha_Inscripcion] =null,
--[Sispho_Inscripcion] = isnull(wss.COD_SISFOH,'SIN REGISTRO'),
[Sispho_Inscripcion] = isnull(ssaj.[Condicion SISFOH a la Adjudicación],'SIN REGISTRO'),
null as [Estado_Validacion],
[Preseleccion] = iif(pos.flag_preinscripcion &gt; 0,'PRESELECCIONADO',null),
[Resolucion_Preseleccion] = null
FROM 
Postulacion pos
inner join Persona per on per.Id_Persona = pos.Id_Persona
inner join Convocatoria con on con.Id_Convocatoria = pos.Id_Convocatoria
inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106,108)
left join pos_inscripcion fecins on fecins.Id_Postulacion = pos.Id_Postulacion
left join db_pronabec_02..RENIEC_ConsultaPreviaAdjudicación wrr on wrr.Expediente = pos.Id_Postulacion
left JOIN  db_pronabec.dbo.Ubigeo_Reniec AS ur ON ur.Cod_Reg = wrr.[Codigo Region RENIEC a la Adjudicación] AND ur.Cod_Pro = wrr.[Codigo Provincia RENIEC a la Adjudicación] AND wrr.[Codigo Distrito RENIEC a la Adjudicación] = ur.Cod_Dis
--left join WS_RENIEC_RESUMEN wr on wr.NUMDOC=per.Nro_Documento
--left join Ubigeo_Reniec ur on ur.Cod_Reg=wr.DPTODOMICILIO and ur.Cod_Pro=wr.PROVDOMICILIO and ur.Cod_Dis=wr.DISTDOMICILIO
left join General vr on vr.Id_General=ur.Id_General
LEFT JOIN General g ON pos.Id_UbigeoDireccion = g.Id_General 
LEFT JOIN General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13 
--left join dbo.WS_SISFOH_RESUMEN AS wss ON wss.NU_DOC_NACIMIENTO = per.Nro_Documento
left join db_pronabec_02..SISFOH_ConsultaPreviaAdjudicación ssaj on ssaj.Expediente=pos.Id_Postulacion

where
pos.Id_Convocatoria not in (265,266,267,268,269,270,271,272,293)
and
pos.Id_Convocatoria in
(
	select distinct ps.Id_Convocatoria
	from Postulacion ps
	inner join Convocatoria con on con.Id_Convocatoria = ps.Id_Convocatoria and con.Id_Modalidad &lt;&gt; 55
	where 
	ps.Id_Convocatoria &lt;&gt; 324 -- PRESELECCIONADOS 2022
	and ps.flag_preinscripcion is not null
)
and 
(
	(
		pos.flag_preinscripcion is null 
		AND pos.Id_Estado in (2679,2223)
	)
	OR 
	(
		pos.flag_preinscripcion &gt;= 0
	)
)

/*
--138,175,180 (fechas muy dispersas)
--184 pos.Fec_Postulacion  EN PROCESO DE REGISTRO con fecha de postulacion

--243,244,245,246,247,248,249,250,255 pos.Fec_modificacion else pos.Fec_Postulacion
--278,279,283 ins.Fec_Postulacion
*/
/*
preseleccion 2019
select Fec_Postulacion,* from Postulacion where Id_Convocatoria between 243 and 250 and flag_preinscripcion is null
select Fec_modificacion, * from Postulacion where Id_Convocatoria between 243 and 250 and flag_preinscripcion=1
preseleccion 2020
SELECT Fec_Postulacion,* FROM pos_inscripcion where Id_Convocatoria between 265 and 272
*/</property>
                <property
                  dataType="System.String"
                  description="Variable que contiene el comando SQL para ejecutar."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos."
                  name="DefaultCodePage">1252</property>
                <property

                <component
                  refId="Package\Carga Dimension Colegio Estudio\Carga_sa_Dim_Colegio_Estudio_Esq_Ant\Origen Colegio_Estudio Transac Esq_Ant"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Colegio_Estudio Transac Esq_Ant"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
concat(1,pos.Id_Postulacion) as 'Id_Postulacion_Preadj'
,cole.Codigo_modular
,cole.Colegio_nombre
,tgcl.Nombre as 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,T_prom.T_prom_dat as 'PROM_GEN'
,acaren2.Periodo as 'Grado'
,acaren2.Anio
,iif(pees.Concluido = 1,'EGRESADO','ESTUDIANDO') as 'EGRESO'
,reac.Promedio
,reac.Condicion
,acaren2.Fec_Reg as 'fecha_registro'
from Convocatoria con
inner join Postulacion pos on pos.Id_Convocatoria = con.Id_Convocatoria
inner join PE_Persona_Estudio acaren2 on acaren2.Id_Concurso = con.Id_Concurso and acaren2.Id_Persona = pos.Id_Persona
inner join Colegio cole on cole.id_colegio = acaren2.Id_Colegio
inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106)
LEFT JOIN db_pronabec.dbo.General g ON cole.id_ubigeo_ubicacion = g.Id_General 
LEFT JOIN db_pronabec.dbo.General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN db_pronabec.dbo.General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
left join Dependencia tgcl on tgcl.Id_Dependencia = cole.id_tipo_gestion
left join Modalidad_Estudio mdl on mdl.id_modalidad = cole.id_modalidad
inner join 
(
	select pos.Id_Postulacion,MAX(acaren1.Periodo) as 'ULT_GRADO'
	from Convocatoria con
	inner join Postulacion pos on pos.Id_Convocatoria = con.Id_Convocatoria
	inner join dbo.PE_Persona_Estudio acaren1 on acaren1.Id_Concurso = con.Id_Concurso and acaren1.Id_Persona = pos.Id_Persona
	inner join Colegio cole on cole.id_colegio = acaren1.Id_Colegio
	group by Id_Postulacion
) acaren3 on acaren3.Id_Postulacion = pos.Id_Postulacion and acaren3.ULT_GRADO = acaren2.Periodo
left join pos_rendimiento_academico reac on reac.Id_Concurso = con.Id_Concurso and reac.Id_Persona = pos.Id_Persona 
and reac.Grado = acaren3.ULT_GRADO
left join 
(
	select pos.Id_Postulacion,AVG(Promedio) as 'T_prom_dat'
	from Convocatoria con
	inner join Postulacion pos on pos.Id_Convocatoria = con.Id_Convocatoria
	inner join pos_rendimiento_academico acaren1 on acaren1.Id_Concurso = con.Id_Concurso and acaren1.Id_Persona = pos.Id_Persona
	inner join Colegio cole on cole.Codigo_modular = acaren1.Codigo_Modular
	group by Id_Postulacion
) T_prom on T_prom.Id_Postulacion = pos.Id_Postulacion
left join dbo.PE_Persona_Estudio pees on pees.Id_Persona = acaren2.Id_Persona and pees.Id_Concurso = acaren2.Id_Concurso
and pees.Anio = acaren2.Anio and pees.Periodo = acaren2.Periodo
union 
select 
concat(1,po.Id_Postulacion) as 'Id_Postulacion_Preadj'
,co.Codigo_modular
,co.Colegio_nombre
,tgcl.Nombre as 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,null
,ult.periodo as 'Grado'
,ult.anio
,'EGRESADO'
,null
,null
,null
from Postulacion po
inner join Convocatoria con on con.Id_Convocatoria=po.Id_Convocatoria
inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106)
inner join  Persona pe on po.Id_Persona=pe.Id_Persona
inner join (SELECT distinct Id_Persona,id_institucion_educativa,periodo,anio FROM(select Per=Id_Persona,MAX(d.periodo) AS mAXpERIODO from Estudio_IE_cab c inner join  Estudio_IE_det d on d.id_estudio=c.id_estudio group by Id_Persona) M 
INNER JOIN (select c.*,d.periodo,d.anio from Estudio_IE_cab c
inner join  Estudio_IE_det d on d.id_estudio=c.id_estudio) R ON R.Id_Persona=M.Per and R.periodo=mAXpERIODO) ult on ult.Id_Persona=po.Id_Persona 
inner join Colegio co on ult.id_institucion_educativa=co.id_colegio
LEFT JOIN db_pronabec.dbo.General g ON co.id_ubigeo_ubicacion = g.Id_General 
LEFT JOIN db_pronabec.dbo.General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN db_pronabec.dbo.General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
left join Dependencia tgcl on tgcl.Id_Dependencia = co.id_tipo_gestion
left join Modalidad_Estudio mdl on mdl.id_modalidad = co.id_modalidad
inner join Convocatoria conv on conv.Id_Convocatoria=po.Id_Convocatoria and left(conv.Codigo_anual_convocat,4) &lt; 2018
inner join Beca bc on bc.Id_Beca=con.Id_Beca
union 
select 
concat(1,po.Id_Postulacion) as 'Id_Postulacion_Preadj'
,co.Codigo_modular
,co.Colegio_nombre
,tgcl.Nombre as 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,null
,ult.periodo as 'Grado'
,ult.anio
,'EGRESADO'
,null
,null
,null
from Postulacion po
inner join Convocatoria con on con.Id_Convocatoria=po.Id_Convocatoria
inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106)
inner join  Persona pe on po.Id_Persona=pe.Id_Persona
inner join (SELECT distinct Id_Persona,id_institucion_educativa,periodo,anio FROM(select Per=Id_Persona,MAX(d.periodo) AS mAXpERIODO from Estudio_IE_cab c inner join  Estudio_IE_det d on d.id_estudio=c.id_estudio group by Id_Persona) M 
INNER JOIN (select c.*,d.periodo,d.anio from Estudio_IE_cab c
inner join  Estudio_IE_det d on d.id_estudio=c.id_estudio) R ON R.Id_Persona=M.Per and R.periodo=mAXpERIODO) ult on ult.Id_Persona=po.Id_Persona 
inner join Colegio co on ult.id_institucion_educativa=co.id_colegio
LEFT JOIN db_pronabec.dbo.General g ON co.id_ubigeo_ubicacion = g.Id_General 
LEFT JOIN db_pronabec.dbo.General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN db_pronabec.dbo.General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
left join Dependencia tgcl on tgcl.Id_Dependencia = co.id_tipo_gestion
left join Modalidad_Estudio mdl on mdl.id_modalidad = co.id_modalidad
inner join Convocatoria conv on conv.Id_Convocatoria=po.Id_Convocatoria and conv.Id_Convocatoria  in (224,225) 
inner join Beca bc on bc.Id_Beca=con.Id_Beca
union
select
concat(1,po.Id_Postulacion) as 'Id_Postulacion_Preadj'
,co.Codigo_modular
,co.Colegio_nombre
,tgcl.Nombre as 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,null
,ult.Periodo as 'Grado'
,ult.Anio
,'EGRESADO'
,null
,null
,null
from 
Postulacion po 	
--inner join	PE_Estudio es  on po.Id_Postulacion=es.Id_Postulacion
inner join Persona pe on pe.Id_Persona=po.Id_Persona
inner join Convocatoria con on con.Id_Convocatoria=po.Id_Convocatoria
inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106)
inner join (SELECT Id_Postulacion,Id_Colegio,Periodo,Anio FROM(select Pos=Id_Postulacion,MAX(Periodo) AS mAXpERIODO from PE_Estudio c group by Id_Postulacion) M 
INNER JOIN (select * from PE_Estudio d) R ON R.Id_Postulacion=M.Pos and R.Periodo=mAXpERIODO) ult on ult.Id_Postulacion=po.Id_Postulacion
inner join Colegio co on ult.Id_Colegio=co.id_colegio
LEFT JOIN db_pronabec.dbo.General g ON co.id_ubigeo_ubicacion = g.Id_General 
LEFT JOIN db_pronabec.dbo.General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN db_pronabec.dbo.General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
left join Dependencia tgcl on tgcl.Id_Dependencia = co.id_tipo_gestion
left join Modalidad_Estudio mdl on mdl.id_modalidad = co.id_modalidad
inner join Beca bc on bc.Id_Beca=con.Id_Beca 
--inner join db_concursos.config.enumerado coar on coar.I_TIPO_ENUMERADO_ID=25 and coar.V_CODIGO=co.Codigo_modular  --colegio COAR
WHERE con.Codigo_anual_convocat like '%2018%' and po.Id_Convocatoria  not in (224,225,242,235,199,251,253)</property>

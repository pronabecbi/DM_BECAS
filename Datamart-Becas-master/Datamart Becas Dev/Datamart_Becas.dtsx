            </component>
            <component
              refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen Postulaciones Esq Nuev Transac"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
cast(IIF(par.I_POSTULACION_ID is null, par.I_PARTICIPANTE_ID,par.I_POSTULACION_ID)as Int) as 'Id_Postulacion_Adj',
par.I_POSTULACION_ID AS 'Id_Postulacion_Pron',
null as 'Id_Postulacion_Bap',
par.I_PARTICIPANTE_ID as 'I_Participante_Conc',
2 as 'Id_Esquema',
concat(2,par.I_PARTICIPANTE_ID) as 'Id_Postulacion_Preadj',
par.I_PERSONA_ID as 'Id_Persona',
CASE 
WHEN par.I_POSTULACION_ID is not null then pos.Id_InstitucionEducativa
WHEN isc.I_INSTITUCION_ID = 0 THEN 9999999
ELSE isc.I_INSTITUCION_ID
END 'Id_Institucion',
CASE 
WHEN par.I_POSTULACION_ID is not null then pos.Id_InstitucionSede
WHEN isc.I_SEDE_ID = 0 THEN 9999999
ELSE isc.I_SEDE_ID
END 'Id_Institucion_Sede',
CASE 
WHEN par.I_POSTULACION_ID is not null then pos.Id_Carrera
WHEN isc.I_CARRERA_ID = 0 THEN 9999999
ELSE isc.I_CARRERA_ID
END 'Id_Carrera',
--cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int) as 'Id_Convocatoria',
isnull(cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int),
(select top 1 cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int) from config.modalidad mm where mm.I_CONCURSO_ID = con.I_CONCURSO_ID and UPPER(con.V_NOMBRE) not like '%BECA 18')) as 'Id_Convocatoria',
con.I_CONCURSO_ID as 'Id_Concurso',
CASE when mom.I_MOMENTO_ID=80 THEN 'Primer momento' when  mom.I_MOMENTO_ID=81 THEN 'Segundo momento' ELSE  mom.V_NOMBRE  END as 'Momento', --mom.V_NOMBRE as 'Momento',
cast(isnull(edab.V_CLAIM_VALOR,edab1.V_CLAIM_VALOR) as varchar(500)) as 'Edad_Bases',
cast(isnull(regrn.V_NOMBRE,regrn1.V_NOMBRE) as varchar(500)) as 'Region_Reniec',
cast(isnull(prvrn.V_NOMBRE,prvrn1.V_NOMBRE) as varchar(500)) as 'Provincia_Reniec',
cast(isnull(dstrn.V_NOMBRE,dstrn1.V_NOMBRE) as varchar(500)) as 'Distrito_Reniec',
[Tipo_Pais_Postulacion]=ISNULL(CASE WHEN (con.I_BECA_ID = 3 AND len(pardap.V_UBIGEO) = 2) OR (con.I_BECA_ID = 5 and pabap.V_CLAIM_VALOR &lt;&gt;'PERU') THEN 'INTERNACIONAL' WHEN regdap.V_CODIGO &lt; 26 THEN 'NACIONAL' WHEN regdap.V_CODIGO &gt; 25 THEN 'INTERNACIONAL' ELSE 'NO REGISTRADO' END,'NO REGISTRADO'),
[Pais_Postulacion]=ISNULL(CASE WHEN (con.I_BECA_ID = 3 AND len(pardap.V_UBIGEO) = 2) THEN bgbpa.Descripcion WHEN con.I_BECA_ID = 5 THEN pabap.V_CLAIM_VALOR WHEN regdap.V_CODIGO &lt; 26 THEN 'PERU' ELSE regdap.V_NOMBRE END,'NO REGISTRADO'),
[Region_Postulacion]=regdap.V_NOMBRE,                                  
[Provincia_Postulacion]=prvdap.V_NOMBRE,                                  
[Distrito_Postulacion]=dstdap.V_NOMBRE,
cast(CASE WHEN vrm.B_VRAEM_RENIEC = '1' THEN 'VRAEM' WHEN vrm.B_VRAEM_RENIEC = '0' THEN 'NO VRAEM' ELSE 'SIN REGISTRO' END as varchar(500)) as 'FLAG_VRAEM',
--iif(clmvrm.V_CLAIM_VALOR = 1, 'VRAEM'') as 'FLAG_VRAEM',
(select cenu.V_NOMBRE from db_concursos.config.estado cenu where  cenu.I_ESTADO_ID=mdlps.I_ESTADO_MODULO ) as 'Estado_Postulacion',
mdlps.D_TERMINO as 'Fecha_Postulacion',
cast(isnull(cosf2.V_CSE_CATEGORIA,'SIN REGISTRO')as varchar(500)) as 'Sispho_Postulacion',
nrval.V_CODIGO as 'Estado_Validacion',
case when parsel.I_PARTICIPANTE_ID is not null then 'SELECCIONADO' else NULL END as 'Estado_Seleccion',
case when parsel.I_ESTADO_MODULO='108003' and racep.I_RESULTADO ='310001' then 'ACEPTO' 
when parsel.I_ESTADO_MODULO='108003' and racep.I_RESULTADO='310002' then 'RENUNCIO' END as 'Estado_Aceptacion',
--case 
--when (pos.flag_becario is null and (pos.Resolucion_Beca is not null or (pos.Resolucion_Nulidad_Beca is not null and pos.flag_beneficiario is not null) ) ) then 'REVERTIDO' 
--when pos.flag_becario is not null then 'ADJUDICADO' else null end
----iif(pos.flag_becario is not null,'ADJUDICADO',null) 
--as 'Estado_Adjudicado', -- NUEVO
--case 
--when (pos.flag_becario is null and (pos.Resolucion_Beca is not null or (pos.Resolucion_Nulidad_Beca is not null and pos.flag_beneficiario is not null) ) ) then 'POSTULANTE' 
--when pos.flag_becario = 1 then 'ACTIVO' 
--when pos.flag_becario = 0 then 'INACTIVO' 
--end as 'Estado_Beca',
iif(pos.flag_becario is not null,'ADJUDICADO',null) as 'Estado_Adjudicado', -- NUEVO
case when pos.flag_becario = 1 then 'ACTIVO' when pos.flag_becario = 0 then 'INACTIVO' ELSE NULL END as 'Estado_Beca',
case when (Cond.Descripcion is null and gen2.Descripcion is null and pos.flag_becario is null) then null
	 when Cond.Descripcion is null then gen2.Descripcion
	 else Cond.Descripcion
end as 'Condicion_Beca',
case when (Situ.Descripcion is null and Situ2.Descripcion is null and pos.flag_becario is null) then null 
	 when Situ.Descripcion is null then Situ2.Descripcion
	 else Situ.Descripcion 
end as 'Situacion_Beca',
pos.Resolucion_Beca,
pos.Fec_Resolucion_Beca,
pos.Resolucion_Beneficiario, 
pos.Fecha_Resolucion_Beneficiario,
pos.Resolucion_Ret_Beca,
pos.Fec_Resolucion_Ret_Beca
,pos.Resolucion_Nulidad_Beca
,pos.Fec_Resolucion_Nulidad_Beca
from proceso.participante par
inner join proceso.participante_modulo mdlps on par.I_PARTICIPANTE_ID = mdlps.I_PARTICIPANTE_ID and mdlps.I_ESTADO_MODULO in (103001,103002,103003) and mdlps.I_MODULO_ID = (select I_MODULO_ID from config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 3) --automatizar
inner join config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
inner join config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and con.I_BECA_ID not in (48, 46, 37, 36, 32) --and con.I_CONCURSO_ID in (11,25,43)
left join proceso.participante_carrera isc on isc.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID and isc.B_PRINCIPAL =1 and isc.I_OPCION=1
--left join db_pronabec.dbo.Postulacion pos on pos.Id_Postulacion = par.I_POSTULACION_ID
left join proceso.participante_modalidad mo on mo.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
left join config.modalidad mm on mm.I_MODALIDAD_ID = mo.I_MODALIDAD_ID
--
left join
	(
		select 
		par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
		par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
		par2.I_MOMENTO_ID as 'I_MOMENTO_2',
		par1.I_MOMENTO_ID as 'I_MOMENTO_1'
		from db_concursos.proceso.participante par2
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(con.V_NOMBRE) LIKE '%BECA 18%'
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1' and mom.V_NOMBRE = 'Preseleccion'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
		) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_2 = par.I_PARTICIPANTE_ID	   
--
left join proceso.participante_claim edab WITH (NOLOCK) on  edab.V_CLAIM_NOMBRE='EDAD_BASES' and edab.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID
left join proceso.participante_claim edab1 WITH (NOLOCK) on  edab1.V_CLAIM_NOMBRE='EDAD_BASES' and edab1.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1

left join proceso.participante_claim corn WITH (NOLOCK) on  corn.V_CLAIM_NOMBRE='DOM_RENIEC' and corn.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID
left join config.enumerado regrn on regrn.I_TIPO_ENUMERADO_ID=19 and regrn.V_CODIGO=LEFT(corn.V_CLAIM_VALOR,2)                        
left join config.enumerado prvrn on prvrn.I_TIPO_ENUMERADO_ID=20 and prvrn.V_CODIGO=LEFT(corn.V_CLAIM_VALOR,4)                        
left join config.enumerado dstrn on dstrn.I_TIPO_ENUMERADO_ID=21 and dstrn.V_CODIGO=corn.V_CLAIM_VALOR    

left join proceso.participante_claim corn1 WITH (NOLOCK) on  corn1.V_CLAIM_NOMBRE='DOM_RENIEC' and corn1.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1
left join config.enumerado regrn1 on regrn1.I_TIPO_ENUMERADO_ID=19 and regrn1.V_CODIGO=LEFT(corn1.V_CLAIM_VALOR,2)                        
left join config.enumerado prvrn1 on prvrn1.I_TIPO_ENUMERADO_ID=20 and prvrn1.V_CODIGO=LEFT(corn1.V_CLAIM_VALOR,4)                        
left join config.enumerado dstrn1 on dstrn1.I_TIPO_ENUMERADO_ID=21 and dstrn1.V_CODIGO=corn1.V_CLAIM_VALOR
left join db_concursos.datos.direccion pardap on pardap.I_DIRECCION_ID='140001' and pardap.I_PARTICIPANTE_MOD_ID=mdlps.I_PARTICIPANTE_MOD_ID                                  
left join db_concursos.config.enumerado regdap on regdap.I_TIPO_ENUMERADO_ID=19 and regdap.V_CODIGO=LEFT(pardap.V_UBIGEO,2)                                  
left join db_concursos.config.enumerado prvdap on prvdap.I_TIPO_ENUMERADO_ID=20 and prvdap.V_CODIGO=LEFT(pardap.V_UBIGEO,4)                                  
left join db_concursos.config.enumerado dstdap on dstdap.I_TIPO_ENUMERADO_ID=21 and dstdap.V_CODIGO=pardap.V_UBIGEO 
left join db_pronabec.dbo.General bgbpa on bgbpa.Codigo = pardap.V_UBIGEO and bgbpa.Tipo_Tabla = 16

left join db_concursos.proceso.participante_claim pabap WITH (NOLOCK) on pabap.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID and pabap.V_CLAIM_NOMBRE='PAIS'               
left join datos.vraem_huallaga vrm on vrm.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
--left join proceso.participante_claim cosf2 on cosf2.V_CLAIM_NOMBRE='SISFOH' and cosf2.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID
left join vulnerabilidad.clasificacion_se cosf2 on cosf2.I_PARTICIPANTE_MOD_ID = mdlps.I_PARTICIPANTE_MOD_ID
left join proceso.participante_modulo parval on  parval.I_PARTICIPANTE_ID=mdlps.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select max(I_MODULO_ID) from config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar     
left join validacion.resultado rval on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1
--left join proceso.participante_claim clmvrm on clmvrm.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID and clmvrm.V_CLAIM_NOMBRE = 'VRAEM'
left join config.enumerado nrval on nrval.I_ENUMERADO_ID=rval.I_RESULTADO 
left join proceso.participante_modulo parsel on  parsel.I_PARTICIPANTE_ID=mdlps.I_PARTICIPANTE_ID and parsel.I_MODULO_ID in (select I_MODULO_ID from config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 8) -- automatizar   
left join validacion.resultado racep on racep.I_PARTICIPANTE_MOD_ID=parsel.I_PARTICIPANTE_MOD_ID and racep.B_ESTADO = 1
left join db_pronabec.dbo.Postulacion pos on pos.Id_Postulacion = par.I_POSTULACION_ID and pos.Id_Convocatoria &gt; 290--and pos.flag_becario is not null
left join db_pronabec.dbo.S_Subvenciones su on su.Id_Postulacion = pos.Id_Postulacion
left join db_pronabec.dbo.General Cond on Cond.Id_General = su.Estado_Subvencion and Cond.Tipo_Tabla = 61
left join db_pronabec.dbo.General Situ on Situ.Id_General = su.Observacion_Estado and Situ.Tipo_Tabla = 61
left join db_pronabec.dbo.General gen2 on gen2.Id_Ubicacion=pos.Id_Motivo_Ret_Beca and gen2.Tipo_Tabla=61
left join db_pronabec.dbo.General Situ2 on Situ2.Id_Ubicacion=pos.Id_Motivo_Obs and Situ2.Tipo_Tabla=61
--where pos.Id_Postulacion = 872914 francisco
--where isnull(cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int),0) = 327 AND par.I_POSTULACION_ID = 912938</property>
                <property
                  dataType="System.String"
                  description="Variable que contiene el comando SQL para ejecutar."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Fuerza el uso del valor de la propiedad DefaultCodePage al describir datos de caracteres."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Especifica el modo utilizado para obtener acceso a la base de datos."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="Asignaciones entre los parámetros del comando SQL y las variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[10.70.1.70.db_concursos.User_fvr]"
                  connectionManagerRefId="Package.ConnectionManagers[10.70.1.70.db_concursos.User_fvr]"
                  description="La conexión de tiempo de ejecución OLE DB usada para obtener acceso a la base de datos."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB]"
                  name="Salida de origen de OLE DB">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Persona]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversión"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].ExternalColumns[Id_Persona]"
                      lineageId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Persona]"
                      name="Id_Persona"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Institucion]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversión"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].ExternalColumns[Id_Institucion]"
                      lineageId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Institucion]"
                      name="Id_Institucion"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Carrera]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversión"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].ExternalColumns[Id_Carrera]"
                      lineageId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Carrera]"
                      name="Id_Carrera"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Origen Postulaciones Esq Nuev Transac.Outputs[Salida de origen de OLE DB].Columns[Id_Convocatoria]"
                      dataType="i4"

                <component
                  refId="Package\Carga Dimension Origen Etnica\Carga_sa_Dim_Origen_Etnica_Esq_Nuev\Origen Transac Origen_Etnica_Esq_Nuev"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Transac Origen_Etnica_Esq_Nuev"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
[Id_Postulacion_Preadj] = cast(concat('2',I_PARTICIPANTE_ID)as int)
,[Selec_Identifica_Etnia]= case when I_PUEBLO_OPCION = 8 THEN 'OTRO' ELSE 'SI' END 
,[Identifica_Etnia] = upper(V_PUEBLO_DESCRIPCION) 
,[Selec_Lengua_Materna] = case when I_LENGUA_OPCION IN (9,12) THEN 'OTRO' ELSE 'SI' END
,[Lengua_Materna] = upper(V_LENGUA_DESCRIPCION)
,[Fecha_Registro] = D_REGISTRO 
from datos.variables_etnicas

union all
/*===================================db_concursos solo 2do momento trayendo el dato del 1er momento =========================================================*/

	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	--,[Discapacidad]= (select cenu.V_NOMBRE from db_concursos.config.enumerado cenu where cenu.I_TIPO_ENUMERADO_ID=18 and cenu.I_ENUMERADO_ID=codi.V_CLAIM_VALOR)             
	,[Selec_Identifica_Etnia]= case when etn.I_PUEBLO_OPCION = 8 THEN 'OTRO' ELSE 'SI' END 
	,[Identifica_Etnia] = upper(etn.V_PUEBLO_DESCRIPCION) 
	,[Selec_Lengua_Materna] = case when etn.I_LENGUA_OPCION IN (9,12) THEN 'OTRO' ELSE 'SI' END
	,[Lengua_Materna] = upper(etn.V_LENGUA_DESCRIPCION)
	,[Fecha_Registro] = etn.D_REGISTRO 
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%' and conc.I_ANIO in (2022,2023)
	inner join
	(
		select 
		par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
		par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
		par2.I_MOMENTO_ID as 'I_MOMENTO_2',
		par1.I_MOMENTO_ID as 'I_MOMENTO_1'
		from db_concursos.proceso.participante par2
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(con.V_NOMBRE) LIKE '%BECA 18%'
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
		) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_2 = par.I_PARTICIPANTE_ID	   
	--inner join db_concursos.proceso.participante par2 on par2.V_NUM_DOCUMENTO=par.V_NUM_DOCUMENTO  --and par2.I_MOMENTO_ID=1
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 3
	inner join datos.variables_etnicas etn on etn.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1
	--where cast(concat('2',par.I_PARTICIPANTE_ID)as int) = 2575591

	union all

	/*===================================db_concursos solo 2do momento que no postularon al 1er momento ===========================================*/

	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	--,parx.I_PARTICIPANTE_ID_1
	--,md.I_MODULO_ID
	,[Selec_Identifica_Etnia]= case when etn.I_PUEBLO_OPCION = 8 THEN 'OTRO' ELSE 'SI' END 
	,[Identifica_Etnia] = upper(etn.V_PUEBLO_DESCRIPCION) 
	,[Selec_Lengua_Materna] = case when etn.I_LENGUA_OPCION IN (9,12) THEN 'OTRO' ELSE 'SI' END
	,[Lengua_Materna] = upper(etn.V_LENGUA_DESCRIPCION)
	,[Fecha_Registro] = etn.D_REGISTRO 
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%' and conc.I_ANIO in (2022,2023)
	inner join
	(
		select 
		par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
		par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
		par2.I_MOMENTO_ID as 'I_MOMENTO_2',
		par1.I_MOMENTO_ID as 'I_MOMENTO_1'
		from db_concursos.proceso.participante par2
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(con.V_NOMBRE) LIKE '%BECA 18%'
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
			WHERE par.I_PARTICIPANTE_ID not in
			(
			select par.I_PARTICIPANTE_ID
			from proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			inner join proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
			inner join config.modulo modu on modu.I_MODULO_ID = parmd.I_MODULO_ID and I_ETAPA_ID = 3			
			)
		) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_2 = par.I_PARTICIPANTE_ID	   
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 2
	inner join datos.variables_etnicas etn on etn.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1
	--and par.I_PARTICIPANTE_ID =571600
	--where parx.I_PARTICIPANTE_ID_1 not in
	--(
	--select par.I_PARTICIPANTE_ID
	--from db_concursos.proceso.participante par
	--inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
	--inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%' and conc.I_ANIO in (2022,2023)
	--)



	--select * from datos.variables_etnicas where I_PARTICIPANTE_ID in ( 394863,571600)
	--select * from proceso.participante where I_PARTICIPANTE_ID = 571600
	--select * from proceso.participante where V_NUM_DOCUMENTO = '76601058'
	--select * from config.momento where I_MOMENTO_ID in (6,10)
	--select * from config.momento where I_CONCURSO_ID = 5
	--select * from config.modulo where I_MOMENTO_ID in (6,10)

	--where cast(concat('2',par.I_PARTICIPANTE_ID)as int) = 2575591
	union all
	/*===================================db_concursos solo 2021 claim =========================================================*/

	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'	
	--,[Discapacidad]= (select cenu.V_NOMBRE from db_concursos.config.enumerado cenu where cenu.I_TIPO_ENUMERADO_ID=18 and cenu.I_ENUMERADO_ID=codi.V_CLAIM_VALOR)             
	,[Selec_Identifica_Etnia]= null
	,[Identifica_Etnia] = null
	,[Selec_Lengua_Materna] = null
	,[Lengua_Materna] = (select cenu.V_NOMBRE from db_concursos.config.enumerado cenu where  cenu.I_ENUMERADO_ID=codi.V_CLAIM_VALOR)
	,[Fecha_Registro] = codi.D_REGISTRO 
	
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_ANIO = 2021 and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%'
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID -- pos
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID in (3)
	inner join db_concursos.proceso.participante_claim codi WITH (NOLOCK) on codi.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi.V_CLAIM_NOMBRE IN ('LENGUA_MATERNA') and codi.V_CLAIM_VALOR &lt;&gt;'170000'
	--where par.I_PARTICIPANTE_ID = (103105)</property>

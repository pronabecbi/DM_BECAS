                    <outputColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Ant_NoInsc\Origen Postulaciones Esq Ant NoIns Transac.Outputs[Salida de origen de OLE DB].Columns[Estado_Adjudicado]"
                      codePage="1252"
                      dataType="str"
                      errorOrTruncationOperation="Conversión"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Carga_sa_Fact_Postulaciones_Esq_Ant_NoInsc\Origen Postulaciones Esq Ant NoIns Transac.Outputs[Salida de origen de OLE DB].ExternalColumns[Estado_Adjudicado]"
                      length="10"
                      lineageId="Package\Carga_sa_Fact_Postulaciones_Esq_Ant_NoInsc\Origen Postulaciones Esq Ant NoIns Transac.Outputs[Salida de origen de OLE DB].Columns[Estado_Adjudicado]"
                      name="Estado_Adjudicado"

                <component
                  refId="Package\Carga Dimension Persona\Carga_sa_Dim_Persona\Origen Persona Transac"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Persona Transac"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select Id_Persona
,ApePaterno
,ApeMaterno
,Nombres
,cast(tido.Descripcion as varchar(250)) as Tipo_Documento
,Nro_Documento
,pe.Fec_Nacimiento
,cast(gese.Descripcion as varchar(60)) as Sexo
,hg.Descripcion as Departamento_Nac
,ig.Descripcion  as Provincia_Nac
,null AS [Departamento_RENIEC]    
,null AS [Provincia_RENIEC]    
,null AS [Distrito_RENIEC]    
,gele.Descripcion as Lengua_mat
,pe.Promedio_Secundaria
,telefono_celular
,Email
from Persona pe 
inner join General tido on tido.Id_General = pe.Id_TipoDocumento
inner join General gese on gese.Id_General = pe.Id_Sexo and gese.Tipo_Tabla = 15
LEFT JOIN General g ON pe.Id_UbigeoNacimiento = g.Id_General 
LEFT JOIN General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
LEFT JOIN General gele on gele.Id_General = pe.Id_LenguaMaterna and gele.Tipo_Tabla = 3
--LEFT JOIN dbo.WS_RENIEC_RESUMEN AS wrr ON wrr.NUMDOC = pe.Nro_Documento
--LEFT JOIN dbo.Ubigeo_Reniec AS ure ON ure.Cod_Reg = wrr.DPTODOMICILIO AND ure.Cod_Pro = wrr.PROVDOMICILIO AND wrr.DISTDOMICILIO = ure.Cod_Dis      
where 
Id_Persona in 
	(
		select Id_Persona from Postulacion po
		inner join Convocatoria co on co.Id_Convocatoria = po.Id_Convocatoria and co.Id_Modalidad &lt;&gt; 55	
		where po.Id_Convocatoria not in (61,59) 
		and co.Id_Programa_Beca not in (100,101,103,106,108)
		--and (po.Id_Estado = 2223 or po.Id_Estado = 2679)
		union 
		select I_PERSONA_ID
		from db_concursos.proceso.participante par
		inner join db_concursos.proceso.participante_modulo mdlps on mdlps.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
		--and mdlps.I_ESTADO_MODULO in (103001,103002,103003)
		where I_PERSONA_ID not in 
		(
			select Id_Persona from Postulacion po
			inner join Convocatoria co on co.Id_Convocatoria = po.Id_Convocatoria and co.Id_Modalidad &lt;&gt; 55	
			where po.Id_Convocatoria not in (61,59) 
			and co.Id_Programa_Beca not in (100,101,103,106,108)
			--and (po.Id_Estado = 2223 or po.Id_Estado = 2679)
		)	
	)</property>

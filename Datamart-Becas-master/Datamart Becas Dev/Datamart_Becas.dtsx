                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[Fec_Resolucion_Ret_Beca]"
                      dataType="dbDate"
                      name="Fec_Resolucion_Ret_Beca" />
                    <externalMetadataColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[Resolucion_Nulidad_Beca]"
                      codePage="1252"
                      dataType="str"
                      length="100"
                      name="Resolucion_Nulidad_Beca" />
                    <externalMetadataColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[Fec_Resolucion_Nulidad_Beca]"
                      dataType="dbDate"
                      name="Fec_Resolucion_Nulidad_Beca" />
                    <externalMetadataColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[Id_Postulacion_Adj]"

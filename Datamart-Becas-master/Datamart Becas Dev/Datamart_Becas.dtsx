        <DTS:Executable
          DTS:refId="Package\Carga Dimension Condicion Priorizable\Actualiza_Id_Discapacitados"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{5B5C65C3-F8BF-460C-9CCA-F1A749594C13}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Actualiza_Id_Discapacitados"
          DTS:ThreadHint="10">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{50AD3F94-D739-47AD-969E-C84B2A2FF676}"
              SQLTask:SqlStatementSource="select &#xA;Disc.Id_Postulacion_Preadj &#xA;,tipo.Discapacidad Discapacidad&#xA;into #Divide_Cadena &#xA;from [sa].[Dim_Condicion_Discapacidad] Disc&#xA;CROSS APPLY sa.DIVIDIR_CADENA(Disc.Discapacidad, ',') as S              &#xA;left join [sa].[Dim_Tipos_Discapacidad] tipo on tipo.Id_Discapacidad = S.[value] &#xA;&#xA;go&#xA;&#xA;SELECT a.Id_Postulacion_Preadj,    &#xA;   STUFF&#xA;   (&#xA;&#x9;   (&#xA;&#x9;&#x9; SELECT DISTINCT ', ' + b.Discapacidad      &#xA;&#x9;&#x9; FROM #Divide_Cadena b           &#xA;&#x9;&#x9; WHERE b.Id_Postulacion_Preadj = a.Id_Postulacion_Preadj           &#xA;&#x9;&#x9; FOR XML PATH(''),TYPE&#xA;&#x9;   ).value('(./text())[1]','VARCHAR(MAX)'),1,1,''&#xA;   ) AS Discapacidad    &#xA;  INTO #Agrupa&#xA;  FROM #Divide_Cadena a&#xA; -- WHERE DNI  = '60349898'&#xA;  GROUP BY Id_Postulacion_Preadj   &#xA;&#xA;go&#xA;&#xA;update x set x.Discapacidad = y.Discapacidad&#xA;--select *&#xA;from [sa].[Dim_Condicion_Discapacidad] x&#xA;inner join #Agrupa y on y.Id_Postulacion_Preadj = x.Id_Postulacion_Preadj" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>

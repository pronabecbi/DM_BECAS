            <component
              refId="Package\Carga_sa_Fact_Postulaciones_Esq_Bap\Origen Postulaciones Esq Bap Transac"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen Postulaciones Esq Bap Transac"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
[Id_Postulacion_Adj] = isnull(propos.Id_Postulacion,pos.Id_Postulacion),
propos.Id_Postulacion AS 'Id_Postulacion_Pron',
pos.Id_Postulacion as 'Id_Postulacion_Bap',
null as 'I_Participante_Conc',
[Id_Esquema] = 3,
[Id_Postulacion_Preadj] = concat(3,pos.Id_Postulacion),
[Id_Persona] = pos.Id_Persona,
[Id_Institucion] = pos.Id_InstitucionEducativa,
[Id_Institucion_Sede] = pos.Id_InstitucionSede,
[Id_Carrera] = pos.Id_Carrera,
[Id_Convocatoria] = 
case
	when pos.Id_Convocatoria = 259 then 262
	when pos.Id_Convocatoria = 260 then 263
	when pos.Id_Convocatoria = 261 then 264
	when pos.Id_Convocatoria = 262 then 273
	else pos.Id_Convocatoria
end,
[Id_Concurso] = null,
'Momento único' as 'Momento',
null as 'Edad_Bases',
[Departamento_Reniec] = ur.Nom_Reg,
[Provincia_Reniec] = ur.Nom_Pro,
[Distrito_Reniec] = ur.Nom_Dis,
[Tipo_Pais_Postulacion]=ISNULL(CASE WHEN hg.Codigo &lt; 26 THEN 'NACIONAL' WHEN hg.Codigo &gt; 25 THEN 'INTERNACIONAL' ELSE 'NO REGISTRADO' END,'NO REGISTRADO'),
[Pais_Postulacion]=ISNULL(CASE WHEN hg.Codigo &lt; 26 THEN 'PERU' ELSE hg.Descripcion END,'NO REGISTRADO'),
[Region_Postulacion]=isnull(cast( hg.Descripcion  as varchar(200)),'NO REGISTRADO'), 
[Provincia_Postulacion]=isnull(cast( ig.Descripcion  as varchar(200)),'NO REGISTRADO'),
[Distrito_Postulacion]=isnull(cast( g.Descripcion  as varchar(200)),'NO REGISTRADO'),
[Flag_Vraem] = case when vr.Inc_VRAE = 1 then 'VRAEM' ELSE 'NO VRAEM' END,
--[Estado_Postulacion] = case when pos.Id_Estado = 2679 then 'REGISTRO COMPLETO' else 'EN PROCESO DE REGISTRO' END,
[Estado_Postulacion] = (select cast(gen.Descripcion as varchar(200)) from General gen where gen.Id_General=pos.Id_Estado),
[Fecha_Postulacion] = pos.Fec_Postulacion,
[Sispho_Postulacion] = isnull(ssaj.[Condicion SISFOH a la Adjudicación],'SIN REGISTRO'),
--[Estado_Validacion] = case when va.Id_Resultado=2164 then 'APTO'when va.Id_Resultado=2165 then 'NO APTO' ELSE NULL END,
[Estado_Validacion] = 
case 
	when va.Id_Resultado=1 then 'APTO'when va.Id_Resultado=0 then 'NO APTO' ELSE NULL END,
[Estado_Seleccion] = 
case when pos.Id_Convocatoria &lt; 240 then case when pos.flag_beneficiario = 0 then 'SELECCIONADO' when pos.flag_beneficiario = 1 then null else null end 
	 when pos.Id_Convocatoria &gt; 240 then case when pos.flag_beneficiario = 1 then 'SELECCIONADO' when pos.flag_beneficiario = 0 then null else null end 
	 else null
end,
[Estado_Aceptacion] = case when ac.Id_Resultado=2164 then 'ACEPTO'when ac.Id_Resultado=2165 then 'RENUNCIO' ELSE NULL END,                                          
[Estado_Adjudicado] = iif(propos.flag_becario is not null,'ADJUDICADO',null),
[Estado_Beca] = case when propos.flag_becario = 1 then 'ACTIVO' when propos.flag_becario = 0 then 'INACTIVO' ELSE NULL END,
--case 
--when (pos.flag_becario is null and (pos.Resolucion_Beca is not null or (pos.Resolucion_Nulidad_Beca is not null and pos.flag_beneficiario is not null) ) ) then 'REVERTIDO' 
--when pos.flag_becario is not null then 'ADJUDICADO' else null end
----iif(pos.flag_becario is not null,'ADJUDICADO',null) 
--as 'Estado_Adjudicado', -- NUEVO
--case 
--when (pos.flag_becario is null and (pos.Resolucion_Beca is not null or (pos.Resolucion_Nulidad_Beca is not null and pos.flag_beneficiario is not null) ) ) then 'POSTULANTE' 
--when pos.flag_becario = 1 then 'ACTIVO' 
--when pos.flag_becario = 0 then 'INACTIVO' 
--end as 'Estado_Beca',
[Condicion_Beca] = case when (Cond.Descripcion is null and gen2.Descripcion is null and pos.flag_becario is null) then null 
	 when Cond.Descripcion is null then gen2.Descripcion
	 else Cond.Descripcion end,
[Situacion_Beca] = case when (Situ.Descripcion is null and Situ2.Descripcion is null and pos.flag_becario is null) then null 
	 when Situ.Descripcion is null then Situ2.Descripcion
	 else Situ.Descripcion end
,propos.Resolucion_Beca
,propos.Fec_Resolucion_Beca
,propos.Resolucion_Beneficiario
,propos.Fecha_Resolucion_Beneficiario
,propos.Resolucion_Ret_Beca
,propos.Fec_Resolucion_Ret_Beca
,propos.Resolucion_Nulidad_Beca
,propos.Fec_Resolucion_Nulidad_Beca
FROM 
Postulacion pos
inner join Persona per on per.Id_Persona = pos.Id_Persona
inner join Convocatoria con on con.Id_Convocatoria = pos.Id_Convocatoria and  con.Id_Modalidad &lt;&gt; 55
--left join db_pronabec..WS_RENIEC_RESUMEN wr on wr.NUMDOC=per.Nro_Documento
--left join db_pronabec..Ubigeo_Reniec ur on ur.Cod_Reg=wr.DPTODOMICILIO and ur.Cod_Pro=wr.PROVDOMICILIO and ur.Cod_Dis=wr.DISTDOMICILIO
left join db_pronabec_02..RENIEC_ConsultaPreviaAdjudicación wrr on wrr.Expediente = pos.Id_Postulacion
left JOIN  db_pronabec.dbo.Ubigeo_Reniec AS ur ON ur.Cod_Reg = wrr.[Codigo Region RENIEC a la Adjudicación] AND ur.Cod_Pro = wrr.[Codigo Provincia RENIEC a la Adjudicación] AND wrr.[Codigo Distrito RENIEC a la Adjudicación] = ur.Cod_Dis
left join General vr on vr.Id_General=ur.Id_General
LEFT JOIN General g ON pos.Id_UbigeoDireccion = g.Id_General 
LEFT JOIN General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13 
--left join db_pronabec..WS_SISFOH_RESUMEN AS wss ON wss.NU_DOC_NACIMIENTO = per.Nro_Documento
left join db_pronabec_02..SISFOH_ConsultaPreviaAdjudicación ssaj on ssaj.Expediente=pos.Id_Postulacion
left join V_Validacion va on va.Id_Postulacion= pos.Id_Postulacion and va.Estado=1 and va.Id_Etapa=2
left join V_Validacion ac on ac.Id_Postulacion= pos.Id_Postulacion and ac.Estado=1 and ac.Id_Etapa=11 --and ac.Id_Estado=1 
left join db_pronabec..Postulacion propos on propos.Id_Postulacion = cast(pos.Numero_ficha_ofin as int)
left join db_pronabec..S_Subvenciones su on su.Id_Postulacion = cast(pos.Numero_ficha_ofin as int)
left join db_pronabec..General Cond on Cond.Id_General = su.Estado_Subvencion and Cond.Tipo_Tabla = 61
left join db_pronabec..General Situ on Situ.Id_General = su.Observacion_Estado and Situ.Tipo_Tabla = 61
left join db_pronabec.dbo.General gen2 on gen2.Id_Ubicacion=pos.Id_Motivo_Ret_Beca and gen2.Tipo_Tabla=61
left join db_pronabec.dbo.General Situ2 on Situ2.Id_Ubicacion=pos.Id_Motivo_Obs and Situ2.Tipo_Tabla=61
where
(pos.Id_Estado = 2223 or pos.Id_Estado = 2679) and 
con.Id_Convocatoria 
in (273,264,263,262,239,238,237,236)</property>

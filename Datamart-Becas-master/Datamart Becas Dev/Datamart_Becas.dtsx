                <component
                  refId="Package\Carga Dimension Colegio Estudio\Carga_sa_Dim_Colegio_Estudio_Esq_Nuev\Origen Colegio_Estudio Transac Esq_Nuev"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Colegio_Estudio Transac Esq_Nuev"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
concat(2,acaren.I_PARTICIPANTE_ID) as 'Id_Postulacion_Preadj'
,acaren.V_COD_MODULAR
,cole.Colegio_nombre
,tgcl.Nombre 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,tb_prom_gen.PROM_GEN
,acaren.I_GRADO
,acaren.I_ANIO
,case colest.B_CONCLUIDO when 1 theN 'EGRESADO' ELSE 'ESTUDIANTE' END as 'EGRESO'
,acaren3.N_PROMEDIO
,acaren3.V_CONDICION
,acaren.D_REGISTRO
--into #temp1
from academico.estudio acaren
INNER JOIN 	(
			select I_PARTICIPANTE_ID,MAX(I_GRADO) as 'ULT_GRADO'
			FROM academico.estudio
			group by I_PARTICIPANTE_ID			
			) acaren2 on acaren2.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID 
						AND acaren2.ULT_GRADO = acaren.I_GRADO
LEFT JOIN (
			select I_PARTICIPANTE_ID,AVG(N_PROMEDIO) as 'PROM_GEN'
			FROM academico.rendimiento
			group by I_PARTICIPANTE_ID
		   ) tb_prom_gen on tb_prom_gen.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID
LEFT JOIN academico.rendimiento acaren3 on acaren3.I_PARTICIPANTE_ID = acaren2.I_PARTICIPANTE_ID 
						AND acaren3.I_GRADO = acaren2.ULT_GRADO
INNER JOIN proceso.participante par on par.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID
INNER JOIN config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and upper(mom.V_NOMBRE) in ('PRESELECCION')
INNER JOIN config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
LEFT JOIN db_pronabec..Colegio cole on cole.Codigo_modular = acaren.V_COD_MODULAR 
LEFT JOIN db_pronabec..Dependencia tgcl on tgcl.Id_Dependencia = cole.id_tipo_gestion
LEFT JOIN db_pronabec.dbo.General g ON cole.id_ubigeo_ubicacion = g.Id_General 
LEFT JOIN db_pronabec.dbo.General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN db_pronabec.dbo.General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
LEFT JOIN db_pronabec..Modalidad_Estudio mdl on mdl.id_modalidad = cole.id_modalidad
LEFT JOIN 
(
	select distinct I_PARTICIPANTE_ID,I_ANIO,I_GRADO,V_COD_MODULAR,B_CONCLUIDO
	from db_concursos.academico.estudio
)colest on colest.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID 
AND colest.I_ANIO = acaren.I_ANIO AND colest.I_GRADO = acaren.I_GRADO AND colest.V_COD_MODULAR = acaren.V_COD_MODULAR
where acaren.I_ESTUDIO_ID not in(313111,978608)-- registro duplicado en origen
--and par.I_PARTICIPANTE_ID in
--(
--select I_PARTICIPANTE_ID
--from proceso.participante_modulo
--where I_MODULO_ID = 376 and I_ESTADO_MODULO = 102003
--)

union all

select 
concat(2,acaren.I_PARTICIPANTE_ID) as 'Id_Postulacion_Preadj'
,acaren.V_COD_MODULAR
,cole.Colegio_nombre
,tgcl.Nombre 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,tb_prom_gen.PROM_GEN
,acaren.I_GRADO
,acaren.I_ANIO
,case colest.B_CONCLUIDO when 1 theN 'EGRESADO' ELSE 'ESTUDIANTE' END as 'EGRESO'
,acaren3.N_PROMEDIO
,acaren3.V_CONDICION
,acaren.D_REGISTRO
--into #temp1
from academico.estudio acaren
INNER JOIN 	(
			select I_PARTICIPANTE_ID,MAX(I_GRADO) as 'ULT_GRADO'
			FROM academico.estudio
			group by I_PARTICIPANTE_ID			
			) acaren2 on acaren2.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID 
						AND acaren2.ULT_GRADO = acaren.I_GRADO
LEFT JOIN (
			select I_PARTICIPANTE_ID,AVG(N_PROMEDIO) as 'PROM_GEN'
			FROM academico.rendimiento
			group by I_PARTICIPANTE_ID
		   ) tb_prom_gen on tb_prom_gen.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID
LEFT JOIN academico.rendimiento acaren3 on acaren3.I_PARTICIPANTE_ID = acaren2.I_PARTICIPANTE_ID 
						AND acaren3.I_GRADO = acaren2.ULT_GRADO
INNER JOIN proceso.participante par on par.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID
INNER JOIN config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and upper(mom.V_NOMBRE) in ('PRIMER MOMENTO','MOMENTO ÚNICO')
INNER JOIN config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
LEFT JOIN db_pronabec..Colegio cole on cole.Codigo_modular = acaren.V_COD_MODULAR 
LEFT JOIN db_pronabec..Dependencia tgcl on tgcl.Id_Dependencia = cole.id_tipo_gestion
LEFT JOIN db_pronabec.dbo.General g ON cole.id_ubigeo_ubicacion = g.Id_General 
LEFT JOIN db_pronabec.dbo.General hg ON LEFT(g.Codigo, 2) = hg.Codigo AND hg.Tipo_Tabla = 12 
LEFT JOIN db_pronabec.dbo.General ig ON LEFT(g.Codigo, 4) = ig.Codigo AND ig.Tipo_Tabla = 13  
LEFT JOIN db_pronabec..Modalidad_Estudio mdl on mdl.id_modalidad = cole.id_modalidad
LEFT JOIN 
(
	select distinct I_PARTICIPANTE_ID,I_ANIO,I_GRADO,V_COD_MODULAR,B_CONCLUIDO
	from db_concursos.academico.estudio
)colest on colest.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID 
AND colest.I_ANIO = acaren.I_ANIO AND colest.I_GRADO = acaren.I_GRADO AND colest.V_COD_MODULAR = acaren.V_COD_MODULAR
where acaren.I_ESTUDIO_ID not in(313111,978608) -- registro duplicado en origen
union all

-- Data rendimiento académico de 2do y tercer momento de convocatorias de beca 18 donde el rendimiento académico solo se registraba en preseleccion y primer momento
select 
concat(2,parx.I_PARTICIPANTE_ID_2) as 'Id_Postulacion_Preadj'
,acaren.V_COD_MODULAR
,cole.Colegio_nombre
,tgcl.Nombre 'Tipo_gestion'
,Region=cast( hg.Descripcion  as varchar(200))
,Provincia=cast( ig.Descripcion  as varchar(200))
,Distrito=cast( g.Descripcion  as varchar(200))
,mdl.nombre_modalidad_estudio as 'modalidad_estudio'
,tb_prom_gen.PROM_GEN
,acaren.I_GRADO
,acaren.I_ANIO
,case colest.B_CONCLUIDO when 1 theN 'EGRESADO' ELSE 'ESTUDIANTE' END as 'EGRESO'
,acaren3.N_PROMEDIO
,acaren3.V_CONDICION
,acaren.D_REGISTRO
from academico.estudio acaren
INNER JOIN 	(
			select I_PARTICIPANTE_ID,MAX(I_GRADO) as 'ULT_GRADO'
			FROM academico.estudio
			group by I_PARTICIPANTE_ID			
			) acaren2 on acaren2.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID 
						AND acaren2.ULT_GRADO = acaren.I_GRADO
LEFT JOIN (
			select I_PARTICIPANTE_ID,AVG(N_PROMEDIO) as 'PROM_GEN'
			FROM academico.rendimiento
			group by I_PARTICIPANTE_ID
		   ) tb_prom_gen on tb_prom_gen.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID

LEFT JOIN academico.rendimiento acaren3 on acaren3.I_PARTICIPANTE_ID = acaren2.I_PARTICIPANTE_ID 
						AND acaren3.I_GRADO = acaren2.ULT_GRADO
INNER JOIN
(
	select 
	par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
	par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
	par2.I_MOMENTO_ID as 'I_MOMENTO_2',
	par1.I_MOMENTO_ID as 'I_MOMENTO_1'
	from proceso.participante par2
	INNER JOIN config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and upper(mom.V_NOMBRE) not in ('PRESELECCION','MOMENTO ÚNICO','PRIMER MOMENTO')
	INNER JOIN config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	-- filtro para mostrar solo postulaciones del 2do momento en adelante
	INNER JOIN config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and con.I_CONCURSO_ID in (1,5) 
	--  filtro solo beca 18 2021 y 2022 donde no se registró rendimiento académico para 2do momento ( en esos concurso solo visualizaban el rendimiento académico de preselección y 1er momento)	
	INNER JOIN
	(
		select par.*,con.I_CONCURSO_ID,con.I_ANIO
		from proceso.participante par
		INNER JOIN config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and upper(mom.V_NOMBRE) in ('MOMENTO ÚNICO','PRIMER MOMENTO')
		INNER JOIN config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
	) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
) parx on parx.I_PARTICIPANTE_ID_1 = acaren.I_PARTICIPANTE_ID
--INNER JOIN proceso.participante par on par.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID
--INNER JOIN config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and upper(mom.V_NOMBRE) not in ('MOMENTO ÚNICO','PRIMER MOMENTO')
--INNER JOIN proceso.participante par on par.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID

                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select concat(2,c.I_PARTICIPANTE_ID) as 'Id_Postulacion_Preadj',e.V_CODIGO as 'Sub_Modalidad'
from proceso.participante_claim c
left join config.enumerado e on e.I_ENUMERADO_ID = c.V_CLAIM_VALOR
where V_CLAIM_NOMBRE = 'CNA_TIPO_DIRECCION'</property>

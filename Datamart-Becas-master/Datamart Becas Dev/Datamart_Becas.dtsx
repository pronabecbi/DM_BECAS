                    <externalMetadataColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[Id_Postulacion_Bap]"
                      dataType="i4"
                      name="Id_Postulacion_Bap" />
                    <externalMetadataColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[I_Participante_Conc]"
                      dataType="i4"
                      name="I_Participante_Conc" />
                    <externalMetadataColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB].ExternalColumns[Edad_Bases]"
                      dataType="i4"
                      name="Edad_Bases" />
                  </externalMetadataColumns>
                </input>
              </inputs>
              <outputs>
                <output
                  refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Outputs[Salida de error de destino de OLE DB]"
                  exclusionGroup="1"
                  isErrorOut="true"
                  name="Salida de error de destino de OLE DB"
                  synchronousInputId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Inputs[Entrada de destino de OLE DB]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Outputs[Salida de error de destino de OLE DB].Columns[ErrorCode]"
                      dataType="i4"
                      lineageId="Package\Carga_sa_Fact_Postulaciones_Esq_Nuev\Destino Postulaciones SA.Outputs[Salida de error de destino de OLE DB].Columns[ErrorCode]"
                      name="ErrorCode"
                      specialFlags="1" />

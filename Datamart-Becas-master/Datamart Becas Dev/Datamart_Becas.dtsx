                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
cast(concat('1',po.Id_Postulacion)as int) as 'Id_Postulacion_Preadj'
	,[Declara_Bombero]= 'SI'
	,[Valida_Bombero] = case when op1.Cumple is null  then '' when op1.Cumple=1  then 'CUMPLE' when op1.Cumple =0  then 'NO CUMPLE' END
from Postulacion po 
inner join Convocatoria con on con.Id_Convocatoria = po.Id_Convocatoria and Id_Programa_Beca not in (101,100,106,103)
inner join Persona pe on pe.Id_Persona=po.Id_Persona 
inner join V_Validacion vv on vv.Id_Postulacion=po.Id_Postulacion and vv.Id_Resultado=2164 and vv.Id_Etapa=24 AND vv.Estado=1 
left join
(
	select vd.Id_Postulacion,vrr.Id_Requisito, vd.Cumple 
	from V_Validacion vv 
	inner join V_Validacion_Detalle vd on  vv.Id_Etapa=24 and vv.Estado=1 and vv.Id_Postulacion=vd.Id_Postulacion and vv.Id_Validacion=vd.Id_Validacion 
	inner join  V_Validacion_Regional_Requeridos vrr ON  vd.Id_Requerido=vrr.Id_Requerido
	where vd.Id_Postulacion in 
	(
		select Id_Postulacion 
		from Postulacion 
		where Id_Estado=2679 and Fec_Postulacion &gt; '01-01-2018' 
	) 
	and vrr.Id_Requisito in (6777,4899,5062,5093,5347,6711)
) op1 on po.Id_Postulacion=op1.Id_Postulacion 
where --po.Id_Convocatoria=@idconv and 
po.Id_Estado=2679 and op1.Cumple is not null</property>
                    <property
                      dataType="System.String"
                      description="Variable que contiene el comando SQL para ejecutar."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"

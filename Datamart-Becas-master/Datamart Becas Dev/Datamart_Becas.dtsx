                <component
                  refId="Package\Carga Dimension Condicion Priorizable\Carga_sa_Dim_Condicion_Discapacidad_Esq_Antiguo\Origen Condicion Discapacidad Transac"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Condicion Discapacidad Transac"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
cast(concat('1',pos.Id_Postulacion)as int) as 'Id_Postulacion_Preadj'
,[Discapacidad] =
case
	when pos.Id_Convocatoria in (310,261,214,180,178,176,175,171,168,167
	,166,165,164,159,158,157,156,155,148,146,142,140,138,137,133,132,131,
	130,129,128,127,126,125,124,123,122,120,119,118,117,116,114,112,111,
	110,109,108,107,105,104,103,101,98,97,96,95,93,92,91,90,89,88,87,86,
	85,84,83,82,80,79,78,77,76,73,72,71,70,68,67,66,65,64,63,62,60,58,55,
	54,53,52,51,50,46,45,44,43,42,41,40,39,38,37,36,34,33,32,31,30,29,28,
	27,26,25,24,23,15,13)	
	then CASE WHEN UPPER(disc.Descripcion) IS NULL OR fse.Discapacidad = 532 THEN 'NO DISCAPACITADO' ELSE UPPER(disc.Descripcion) END -- ficha	
	
	when pos.Id_Convocatoria in (224,215,182,177,166,158,155,148,142,138,133,132,129,
	128,127,126,122,118,117,114,111,110,107,98,97,95,89,86,84,83,82,79,70,
	65,64,55,54,51,50,49,48,47,46,44,39,37,36,34,33,32,31,30,29,28,27,26,
	25,24,22,21,20,18,17,16,12,10,3,2) 
	then iif(Flag_Discapacidad =1,'DISCAPACITADO','NO DISCAPACITADO')
	
	when pos.Id_Convocatoria in (304,287,256,282) 
	then CASE WHEN per.Discapacidad = 5561 THEN 'NO DISCAPACITADO' ELSE UPPER(dis.Descripcion) END  -- Persona	
	
	else 'NO DISCAPACITADO'
	end
,[Discapacidad_Otro_1] = null
,[Discapacidad_Otro_2] = null
,[Val_Doc_Certificado_Discapacidad] = 
case
	when pos.Id_Convocatoria in (310,261,214,180,178,176,175,171,168,167
	,166,165,164,159,158,157,156,155,148,146,142,140,138,137,133,132,131,
	130,129,128,127,126,125,124,123,122,120,119,118,117,116,114,112,111,
	110,109,108,107,105,104,103,101,98,97,96,95,93,92,91,90,89,88,87,86,
	85,84,83,82,80,79,78,77,76,73,72,71,70,68,67,66,65,64,63,62,60,58,55,
	54,53,52,51,50,46,45,44,43,42,41,40,39,38,37,36,34,33,32,31,30,29,28,
	27,26,25,24,23,15,13)	
	then 'DECLARADO FSE' -- ficha	
	
	else 'DECLARADO MOD'
	end

from FichaSE_Cabecera fsec
left join FSE_Familia fse on fse.Id_FichaSE = fsec.Id_FichaSE and fse.Tipo_Familiar = 2215 and Estado = 1
left join FichaSE_Familiar fse2 on fse2.Id_FichaSE = fsec.Id_FichaSE and fse2.Id_TipoParentesco = 2215
left join CriterioSE_Detalle disc on disc.Id_Criterio_Detalle = fse.Discapacidad
inner join Postulacion pos on pos.Id_Postulacion = fsec.Id_Postulacion
left join Convocatoria con on con.Id_Convocatoria = pos.Id_Convocatoria
left join Persona per on per.Id_Persona = fsec.Id_Persona 
left join General dis on dis.Id_General = per.Discapacidad and dis.Tipo_Tabla = 149
where fsec.Id_Postulacion is not null 
and 
(
	(
		pos.Id_Convocatoria in 
		(
		310,261,214,180,178,176,175,171,168,167,166,165,164,159,158,157,156,155,
		148,146,142,140,138,137,133,132,131,130,129,128,127,126,125,124,123,122,
		120,119,118,117,116,114,112,111,110,109,108,107,105,104,103,101,98,97,96,
		95,93,92,91,90,89,88,87,86,85,84,83,82,80,79,78,77,76,73,72,71,70,68,67,
		66,65,64,63,62,60,58,55,54,53,52,51,50,46,45,44,43,42,41,40,39,38,37,36,
		34,33,32,31,30,29,28,27,26,25,24,23,15,13
		)
		and disc.Descripcion IS NOT NULL 
		and fse.Discapacidad &lt;&gt; 532
	)
	OR
	(
		pos.Id_Convocatoria in 
		(
		224,215,182,177,49,48,47,22,21,20,18,17,16,12,10,3,2
		)
		and Flag_Discapacidad = 1
	)
	OR
	(
		pos.Id_Convocatoria in 
		(
		304,287,256,282
		)
		and per.Discapacidad &lt;&gt; 5561
	)
)
union all
select 
cast(concat('1',pos.Id_Postulacion)as int) as 'Id_Postulacion_Preadj'
    ,[Discapacidad] = 'DISCAPACITADO'
	,[Discapacidad_Otro_1] = null
	,[Discapacidad_Otro_2] = null
	,[Val_Doc_Certificado_Discapacidad] = case when op1.Cumple is null  then '' when op1.Cumple=1  then 'CUMPLE' when op1.Cumple =0  then 'NO CUMPLE' END
from Postulacion pos
inner join Convocatoria con on con.Id_Convocatoria = pos.Id_Convocatoria and Id_Programa_Beca not in (101,100,106,103)
inner join Persona pe on pe.Id_Persona=pos.Id_Persona 
left join V_Validacion vv on vv.Id_Postulacion=pos.Id_Postulacion and vv.Id_Resultado=2164 and vv.Id_Etapa=24 AND vv.Estado=1 
left join
(
	select vd.Id_Postulacion,vrr.Id_Requisito, vd.Cumple 
	from V_Validacion vv 
	inner join V_Validacion_Detalle vd on  vv.Id_Etapa=24 and vv.Estado=1 and vv.Id_Postulacion=vd.Id_Postulacion and vv.Id_Validacion=vd.Id_Validacion 
	inner join  V_Validacion_Regional_Requeridos vrr ON  vd.Id_Requerido=vrr.Id_Requerido
	where vd.Id_Postulacion in 
	(
		select Id_Postulacion 
		from Postulacion 
		where Id_Estado=2679 --and Fec_Postulacion &gt; '01-01-2018' 
	) 
	and vrr.Id_Requisito in (2500,3937,4066,5054,5092,5370,6659,6731,6755,6779)
) op1 on pos.Id_Postulacion=op1.Id_Postulacion and op1.Cumple is not null
left join General ds on ds.Id_General = Id_Requisito and Tipo_Tabla = 25
where --po.Id_Convocatoria=@idconv and 
pos.Id_Estado=2679 and op1.Cumple is not null
and pos.Id_Postulacion not in (422428,830189,423970,829773,424866,828849,834496)</property>

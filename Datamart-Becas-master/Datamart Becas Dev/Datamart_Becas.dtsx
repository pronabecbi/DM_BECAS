                <component
                  refId="Package\Carga Dimension Origen Etnica\Destino SA Dim_Origen_Etnica_Esq_Ant\Origen Transac Origen_Etnica_Esq_Ant"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Transac Origen_Etnica_Esq_Ant"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select
cast(concat('1',pos.Id_Postulacion)as int)as 'Id_Postulacion_Preadj'
,case when mt.V_META_VALUE = 'Otro' THEN 'OTRO' ELSE 'SI' end as Selec_Identifica_Etnia
,case when mt.V_META_VALUE = 'Otro' THEN upper(mto.V_META_VALUE) ELSE upper(mt.V_META_VALUE) end as Identifica_Etnia
,'SI' as Selec_Lengua_Materna
,gele.Descripcion as Lengua_Materna
from Postulacion pos
inner join Convocatoria con on con.Id_Convocatoria=pos.Id_Convocatoria
inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106)
left join Persona_Metadata mt on mt.I_PERSONA_ID = pos.Id_Persona and mt.V_META_KEY = 'etnia'
left join Persona_Metadata mto on mto.I_PERSONA_ID = pos.Id_Persona and mto.V_META_KEY = 'etnia_otro'
left join Persona per on per.Id_Persona = pos.Id_Persona 
left join General gele on gele.Id_General = per.Id_LenguaMaterna and gele.Tipo_Tabla = 3
where pos.Id_Convocatoria in (293,294,295,291) --and pos.Id_Estado = 2679 
order by pos.Id_Convocatoria desc
/* análisis sólo 2021, se debe verificar convocatoria por convocatoria en tabla Persona_Metadata y 
ver si la cantidad tiene relacion con la cantidad total de postulantes
*/</property>
                    <property
                      dataType="System.String"
                      description="Variable que contiene el comando SQL para ejecutar."
                      name="SqlCommandVariable"></property>

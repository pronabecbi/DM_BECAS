                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select Id_InstitucionSede,
ise.Nombre as 'Nombre_Sede',ies.Nombre as 'Nombre_IES',
[Pais]=CASE WHEN sige.Codigo &lt; 26 THEN 'PERU' ELSE sige.Descripcion END,
[Departamento]= CASE WHEN LEFT(sige.Codigo,2) &lt;=25 then isnull(cast( sige.Descripcion  as varchar(250)),'') else sig.Descripcion end,
[Provincia]=cast( sig.Descripcion  as varchar(250))
from dbo.Institucion_Sede ise
LEFT JOIN General sig on sig.Id_General = ise.Id_Ubigeo  
LEFT JOIN General sige ON LEFT(sig.Codigo, 2) = sige.Codigo AND sige.Tipo_Tabla = 12
LEFT JOIN Institucion ies on ies.Id_InstitucionEducativa = ise.Id_Institucion</property>
                    <property
                      dataType="System.String"
                      description="Variable que contiene el comando SQL para ejecutar."
                      name="SqlCommandVariable"></property>

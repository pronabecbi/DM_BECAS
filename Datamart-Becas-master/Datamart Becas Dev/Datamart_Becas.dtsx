  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Actualiza_Est_Beca_y_Est_Adj"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{6810B24B-85BA-42A9-9AC2-4F9DF5B1BDCC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Actualiza_Est_Beca_y_Est_Adj"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{50AD3F94-D739-47AD-969E-C84B2A2FF676}"
          SQLTask:SqlStatementSource="update ps set Estado_Adjudicado = 'REVERTIDO',Estado_Beca = 'POSTULANTE'&#xA;--select *&#xA;from &#xA;[sa].[Fact_Becas_Revertidas] r&#xA;inner join sa.Fact_Postulaciones ps on ps.Id_Postulacion_Pron = r.ID_POSTULACION" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Actualiza_Indicadores"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{ECC5CF63-153A-426A-A39A-9E8288CDF587}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Actualiza_Indicadores"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{50AD3F94-D739-47AD-969E-C84B2A2FF676}"
          SQLTask:SqlStatementSource="/*===============INDICADOR BECAS OTORGADAS================*/&#xA;update pos set I_Becas_Otorgadas = 'SI'&#xA;--select B_Becas_Otorgadas,pos.* &#xA;from ods.Fact_Postulaciones pos&#xA;inner join ods.Dim_Convocatoria con on con.Id_Convocatoria = pos.Id_Convocatoria&#xA;where Estado_Adjudicado not in ('SIN REGISTRO','REVERTIDO') -- SE FILTRA REGISTROS NULIDADES Y SOLO QUEDAN BECAS OTORGADAS&#xA;AND left(con.Año_Convocatoria,4) &gt;= 2012 -- SE FILTRA CONVOCATORIAS Y SOLO QUEDAN DEL 2012 EN ADELANTE&#xA;AND Condicion_Beca not in ('NO BECARIO/A POR NULIDAD DEL ACTO ADMINISTRATIVO' -- SE FILTRA CONDICIÓN POR INDICACIÓN DE DIBEC&#xA;,'BECA ANULADA O DECLARACIÓN DE LESIVIDAD') -- SE FILTRA CONDICIÓN POR INDICACIÓN DE DIBEC&#xA;AND Tipo_Convocatoria ='NATURAL' " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Actualiza_ods_Dim_Persona_Nro_Pso"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{47FA89BF-095C-4028-B38E-3AFACF1BC1CC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Actualiza_ods_Dim_Persona_Nro_Pso"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{50AD3F94-D739-47AD-969E-C84B2A2FF676}"
          SQLTask:SqlStatementSource="UPDATE PER      &#xA;  SET PER.Nro_Postulaciones = pos.Nro_pos&#xA;  FROM ods.Dim_Persona AS PER      &#xA;  INNER JOIN (select Id_Persona,count(Id_Postulacion) as 'Nro_pos'&#xA;  from ods.Fact_Postulaciones&#xA;  group by Id_Persona) pos on pos.Id_Persona = PER.Id_Persona" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

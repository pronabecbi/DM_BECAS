      ,isnull([V_COD_MODULAR],'SIN REGISTRO') as [Cod_Modular]
      ,UPPER(isnull([Colegio_nombre],'SIN REGISTRO')) as [Nombre_Colegio]
	  ,UPPER(isnull([Tipo_gestion],'SIN REGISTRO')) as [Tipo_gestion]
	  ,UPPER(isnull([Region],'SIN REGISTRO')) as [Region]
	  ,UPPER(isnull([Provincia],'SIN REGISTRO')) as [Provincia]
	  ,UPPER(isnull([Distrito],'SIN REGISTRO')) as [Distrito]
	  ,UPPER(isnull([modalidad_estudio],'SIN REGISTRO')) as [modalidad_estudio]
      ,case when coa.[V_CODIGO] is not null then 'SI' else 'NO' end as[Flag_Coar]
	  ,isnull([PROM_GEN],999999) as [Promedio_General]
      ,isnull([I_GRADO],999999) as [Grado]
      ,isnull([I_ANIO],999999) as [Anio]
	  ,UPPER(isnull([EGRESO],'SIN REGISTRO')) as [egreso]
      ,isnull([N_PROMEDIO],999999) as [Promedio_Grado]
      ,UPPER(isnull([V_CONDICION],'SIN REGISTRO')) as [Condicion]
      ,MAX([D_REGISTRO])as [Fecha_Registro]
	  --,isnull([D_REGISTRO],'01/01/1800 00:00:00') as [Fecha_Registro]
  FROM [sa].[Dim_Colegio_Estudio] col
  left join sa.Dim_Colegio_Coar coa on coa.[V_CODIGO]=col.V_COD_MODULAR
 -- where [Id_Postulacion_Preadj] = 2856017
  GROUP BY [Id_Postulacion_Preadj]
      ,[V_COD_MODULAR]
      ,[Colegio_nombre]
	  ,[Tipo_gestion] 
	  ,[Region]
	  ,[Provincia]
	  ,[Distrito]
	  ,[modalidad_estudio]
      , coa.[V_CODIGO]
	  ,[PROM_GEN]
      ,[I_GRADO]
      ,[I_ANIO]
	  ,[EGRESO]
      ,[N_PROMEDIO]
      ,[V_CONDICION]
 /*
 SELECT distinct
	   [Id_Postulacion_Preadj]
      ,isnull([V_COD_MODULAR],'SIN REGISTRO') as [Cod_Modular]
      ,UPPER(isnull([Colegio_nombre],'SIN REGISTRO')) as [Nombre_Colegio]
	  ,UPPER(isnull([Tipo_gestion],'SIN REGISTRO')) as [Tipo_gestion]
	  ,UPPER(isnull([Region],'SIN REGISTRO')) as [Region]
	  ,UPPER(isnull([Provincia],'SIN REGISTRO')) as [Provincia]
	  ,UPPER(isnull([modalidad_estudio],'SIN REGISTRO')) as [modalidad_estudio]
      ,case when coa.[V_CODIGO] is not null then 'SI' else 'NO' end as[Flag_Coar]
	  ,isnull([PROM_GEN],999999) as [Promedio_General]
      ,isnull([I_GRADO],999999) as [Grado]
      ,isnull([I_ANIO],999999) as [Anio]
	  ,UPPER(isnull([EGRESO],'SIN REGISTRO')) as [egreso]
      ,isnull([N_PROMEDIO],999999) as [Promedio_Grado]
      ,UPPER(isnull([V_CONDICION],'SIN REGISTRO')) as [Condicion]
      ,isnull([D_REGISTRO],'01/01/1800 00:00:00') as [Fecha_Registro]
  FROM [sa].[Dim_Colegio_Estudio] col
  left join sa.Dim_Colegio_Coar coa on coa.[V_CODIGO]=col.V_COD_MODULAR
 */</property>

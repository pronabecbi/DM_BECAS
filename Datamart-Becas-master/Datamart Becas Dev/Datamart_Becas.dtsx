                  name="Origen Representantes Comunidades Transac_1"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
concat(2,p.I_PARTICIPANTE_ID) as Id_Postulacion_Preadj
,upper(cna_c.V_CLAIM_VALOR) as Cargo_Representante
,cna_d.V_CLAIM_VALOR as DNI_Representante
,upper(cna_n.V_CLAIM_VALOR) as Nombres_Representante
,cna_c.D_REGISTRO as Fecha_Registro
,1 as Id_Estado
--into #TEMP1
from proceso.participante p
inner join proceso.participante_claim cna_c on cna_c.I_PARTICIPANTE_ID = p.I_PARTICIPANTE_ID and cna_c.V_CLAIM_NOMBRE = 'CNA_REP_CARGO'
inner join proceso.participante_claim cna_d on cna_d.I_PARTICIPANTE_ID = p.I_PARTICIPANTE_ID and cna_d.V_CLAIM_NOMBRE = 'CNA_REP_DNI'
inner join proceso.participante_claim cna_n on cna_n.I_PARTICIPANTE_ID = p.I_PARTICIPANTE_ID and cna_n.V_CLAIM_NOMBRE = 'CNA_REP_NOMBRES'
union all
select 
concat(2,p.I_PARTICIPANTE_ID) as Id_Postulacion_Preadj
,upper(pob_c.V_CLAIM_VALOR) as CARGO
,pob_d.V_CLAIM_VALOR as DNI
,upper(pob_n.V_CLAIM_VALOR) as NOMBRES
,pob_c.D_REGISTRO
,1 as I_ESTADO
from proceso.participante p
inner join proceso.participante_claim pob_c on pob_c.I_PARTICIPANTE_ID = p.I_PARTICIPANTE_ID and pob_c.V_CLAIM_NOMBRE = 'POB_REP_CARGO'
inner join proceso.participante_claim pob_d on pob_d.I_PARTICIPANTE_ID = p.I_PARTICIPANTE_ID and pob_d.V_CLAIM_NOMBRE = 'POB_REP_DNI'
inner join proceso.participante_claim pob_n on pob_n.I_PARTICIPANTE_ID = p.I_PARTICIPANTE_ID and pob_n.V_CLAIM_NOMBRE = 'POB_REP_NOMBRES'</property>
                    <property
                      dataType="System.String"
                      description="Variable que contiene el comando SQL para ejecutar."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos."

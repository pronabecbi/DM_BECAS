                      description="Especifica el modo utilizado para obtener acceso a la base de datos."
                      name="AccessMode"
                      typeConverter="AccessMode">2</property>
                    <property
                      dataType="System.String"
                      description="Asignaciones entre los parámetros del comando SQL y las variables."
                      name="ParameterMapping"></property>
                  </properties>
                  <connections>
                    <connection
                      refId="Package\Carga Dimension Institucion Origen\Carga_sa_Dim_Institucion_Origen_Esq_Ant\Origen Transac Institucion_Origen_Esq_Ant.Connections[OleDbConnection]"
                      connectionManagerID="Package.ConnectionManagers[10.70.1.70.db_pronabec.User_fvr]"
                      connectionManagerRefId="Package.ConnectionManagers[10.70.1.70.db_pronabec.User_fvr]"
                      description="La conexión de tiempo de ejecución OLE DB usada para obtener acceso a la base de datos."
                      name="OleDbConnection" />
                  </connections>

                          dataType="i4"
                          lineageId="Package\Carga Dimension Condicion Priorizable\Carga_sa_Dim_Condicion_Discapacidad_Esq_Antiguo\Destino sa Condicion Discapacidad.Outputs[Salida de error de destino de OLE DB].Columns[ErrorColumn]"

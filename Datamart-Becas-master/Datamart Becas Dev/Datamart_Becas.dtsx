)colest on colest.I_PARTICIPANTE_ID = acaren.I_PARTICIPANTE_ID 
AND colest.I_ANIO = acaren.I_ANIO AND colest.I_GRADO = acaren.I_GRADO AND colest.V_COD_MODULAR = acaren.V_COD_MODULAR

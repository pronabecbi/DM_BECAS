                </component>
                <component
                  refId="Package\Carga Dimension Procedencia Comunidades\Carga_sa_Dim_Procedencia_Comunidades\Origen Procedencia Comunidades Transac_1"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Procedencia Comunidades Transac_1"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">--BECAS EN ESQUEMA ANTIGUO DB_PRONABEC	
	select 
	cast(concat('1',po.Id_Postulacion)as int)as 'Id_Postulacion_Preadj',upper(dirtp.Nombre) tipo_comu
	,upper(dir.Detalle) det_comunidad,dr.Descripcion region,dp.Descripcion provincia,dd.Descripcion distrito
	,[Val_Doc_Comunidades] = 'NO APLICA'
	,dir.Fec_Registro as Fecha_Registro
	,0 as 'Id_Estado'
	from 
	Postulacion po
	inner join Convocatoria con on con.Id_Convocatoria=po.Id_Convocatoria
	inner join Programa_Beca pb on pb.Id_Programa_Beca = con.Id_Programa_Beca and pb.Id_Programa_Beca not in (100,101,103,106)
	inner join pos_direccion_postulante dir on dir.Id_Postulacion = po.Id_Postulacion and dir.Id_Tipo in (2,6,7)
	left join pos_direccion_tipo dirtp on dirtp.Id_Tipo = dir.Id_Tipo
	LEFT JOIN General dd on dd.Codigo=LEFT(dir.Ubigeo, 6) and dd.Tipo_Tabla=14
	LEFT JOIN General dp on dp.Codigo=LEFT(dir.Ubigeo, 4) and dp.Tipo_Tabla=13
	LEFT JOIN General dr on dr.Codigo=LEFT(dir.Ubigeo, 2) and dr.Tipo_Tabla=12
	where po.Id_Convocatoria not in (select 
	cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int) as 'Id_Convocatoria'
	from db_concursos.config.concurso c
	inner join db_concursos.config.modalidad mm on mm.I_CONCURSO_ID = c.I_CONCURSO_ID)	
	union 
--BECAS EN ESQUEMA NUEVO DB_CONCURSOS
--los que estan en db_concursos pero no son beca 18 y la comunidad se registro el la seleccion
	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int),upper(enu.V_NOMBRE),upper(drc.V_DETALLE) detalle,dr.Descripcion,dp.Descripcion,dd.Descripcion
	,[Valida_Comunidades] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	,drc.D_REGISTRO as Fecha_Registro
	,0 as 'Id_Estado'
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 3
	inner join db_concursos.datos.direccion drc on drc.I_PARTICIPANTE_MOD_ID = md.I_PARTICIPANTE_MOD_ID and drc.I_DIRECCION_ID in (140002,140007,140006)
	inner join db_concursos.config.enumerado enu on enu.I_ENUMERADO_ID = drc.I_DIRECCION_ID  and enu.I_ENUMERADO_ID in (140002,140007,140006)
	LEFT JOIN General dd on dd.Codigo=LEFT(drc.V_UBIGEO, 6) and dd.Tipo_Tabla=14
	LEFT JOIN General dp on dp.Codigo=LEFT(drc.V_UBIGEO, 4) and dp.Tipo_Tabla=13
	LEFT JOIN General dr on dr.Codigo=LEFT(drc.V_UBIGEO, 2) and dr.Tipo_Tabla=12
	--left join db_pronabec.dbo.Postulacion po on po.Id_Postulacion = par.I_POSTULACION_ID --and po.flag_becario = 1
	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select max(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	left join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID = 120005 	
	and I_MODULO_ID=(select max(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	--where par.I_POSTULACION_ID IS NOT NULL and conc.I_CONCURSO_ID not in (1,5,23)
	where UPPER(conc.V_NOMBRE) NOT LIKE '%BECA 18%'
	union 
--los que estan en db_concursos pero no son beca 18 y la comunidad se registro el la preseleccion
	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int),upper(enu.V_NOMBRE),upper(drc.V_DETALLE) detalle,dr.Descripcion,dp.Descripcion,dd.Descripcion
	,[Valida_Comunidades] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	,drc.D_REGISTRO as Fecha_Registro
	,0 as 'Id_Estado'
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 2
	inner join db_concursos.datos.direccion drc on drc.I_PARTICIPANTE_MOD_ID = md.I_PARTICIPANTE_MOD_ID and drc.I_DIRECCION_ID in (140002,140007,140006)
	inner join db_concursos.config.enumerado enu on enu.I_ENUMERADO_ID = drc.I_DIRECCION_ID  and enu.I_ENUMERADO_ID in (140002,140007,140006)
	LEFT JOIN General dd on dd.Codigo=LEFT(drc.V_UBIGEO, 6) and dd.Tipo_Tabla=14
	LEFT JOIN General dp on dp.Codigo=LEFT(drc.V_UBIGEO, 4) and dp.Tipo_Tabla=13
	LEFT JOIN General dr on dr.Codigo=LEFT(drc.V_UBIGEO, 2) and dr.Tipo_Tabla=12
	--left join db_pronabec.dbo.Postulacion po on po.Id_Postulacion = par.I_POSTULACION_ID --and po.flag_becario = 1
	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	left join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID = 120005 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	--where par.I_POSTULACION_ID IS NOT NULL and conc.I_CONCURSO_ID not in (1,5,23)
	where UPPER(conc.V_NOMBRE) NOT LIKE '%BECA 18%'
	union	
-- db_concursos BECA 18 solo 1er momento e inscripcion
	select	
	cast(concat('2',par.I_PARTICIPANTE_ID)as int)	
	,upper(enu.V_NOMBRE),upper(drc.V_DETALLE) detalle
	,dr.Descripcion
	,dp.Descripcion
	,dd.Descripcion
	,[Val_Doc_Comunidades] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	,drc.D_REGISTRO as Fecha_Registro
	,0 as 'Id_Estado'
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID -- pos
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID in (2,3)
	inner join db_concursos.datos.direccion drc on drc.I_PARTICIPANTE_MOD_ID = md.I_PARTICIPANTE_MOD_ID and drc.I_DIRECCION_ID in (140002,140007,140006)
	inner join db_concursos.config.enumerado enu on enu.I_ENUMERADO_ID = drc.I_DIRECCION_ID  and enu.I_ENUMERADO_ID in (140002,140007,140006)
	LEFT JOIN db_pronabec.dbo.General dd on dd.Codigo=LEFT(drc.V_UBIGEO, 6) and dd.Tipo_Tabla=14
	LEFT JOIN db_pronabec.dbo.General dp on dp.Codigo=LEFT(drc.V_UBIGEO, 4) and dp.Tipo_Tabla=13
	LEFT JOIN db_pronabec.dbo.General dr on dr.Codigo=LEFT(drc.V_UBIGEO, 2) and dr.Tipo_Tabla=12	
	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	left join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID = 120005 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	where UPPER(conc.V_NOMBRE) LIKE '%BECA 18%' and mom.V_CODIGO = 'M1'	
	union	
-- db_concursos solo 2do momento 
	select  
	cast(concat('2',par.I_PARTICIPANTE_ID)as int),upper(enu.V_NOMBRE),upper(drc.V_DETALLE) detalle,dr.Descripcion,dp.Descripcion,dd.Descripcion
	,[Val_Doc_Comunidades] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	,drc.D_REGISTRO as Fecha_Registro
	,0 as 'Id_Estado'
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO in ('M2','M3')
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%'
	inner join
	(
		select 
		par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
		par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
		par2.I_MOMENTO_ID as 'I_MOMENTO_2',
		par1.I_MOMENTO_ID as 'I_MOMENTO_1'
		from db_concursos.proceso.participante par2
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and mom.V_CODIGO in ('M2','M3')
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(con.V_NOMBRE) LIKE '%BECA 18%'
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
		) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_2 = par.I_PARTICIPANTE_ID	   
	--inner join db_concursos.proceso.participante par2 on par2.V_NUM_DOCUMENTO=par.V_NUM_DOCUMENTO  --and par2.I_MOMENTO_ID=1
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID-- and I_ETAPA_ID = 3
	inner join db_concursos.datos.direccion drc on drc.I_PARTICIPANTE_MOD_ID = md.I_PARTICIPANTE_MOD_ID and drc.I_DIRECCION_ID in (140002,140007,140006)
	inner join db_concursos.config.enumerado enu on enu.I_ENUMERADO_ID = drc.I_DIRECCION_ID  and enu.I_ENUMERADO_ID in (140002,140007,140006)
	LEFT JOIN General dd on dd.Codigo=LEFT(drc.V_UBIGEO, 6) and dd.Tipo_Tabla=14
	LEFT JOIN General dp on dp.Codigo=LEFT(drc.V_UBIGEO, 4) and dp.Tipo_Tabla=13
	LEFT JOIN General dr on dr.Codigo=LEFT(drc.V_UBIGEO, 2) and dr.Tipo_Tabla=12
	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	left join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID = 120005 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4)
	)</property>

            <component
              refId="Package\Carga_ods_Fact_Postulaciones\Origen Postulaciones sa"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen Postulaciones sa"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	  pos.[Id_Postulacion_Adj]
	  ,pos.[Id_Esquema]
	  ,pos.[Id_Postulacion_Preadj]
      ,pos.[Id_Persona]
      ,isnull(pos.[Id_Institucion],999999) as [Id_Institucion]
      ,isnull(pos.[Id_Institucion_Sede],999999) as [Id_Institucion_Sede]
      ,isnull(pos.[Id_Carrera],999999) as [Id_Carrera]
      ,isnull(pos.[Id_Convocatoria],ins.Id_Convocatoria) as [Id_Convocatoria]
	  ,UPPER(isnull(pos.[Momento],'SIN REGISTRO')) as [Momento]
	  ,isnull(pos.Edad_Bases,999999) as Edad_Bases
	  ,isnull([ods].[ufnCalcularEdad](per.Fecha_Nacimiento,pos.Fecha_Postulacion),999999) as Edad_Postulacion
      ,isnull(pos.[Departamento_Reniec],'SIN REGISTRO') as [Departamento_Reniec]
      ,isnull(pos.[Provincia_Reniec],'SIN REGISTRO') as [Provincia_Reniec]
      ,isnull(pos.[Distrito_Reniec],'SIN REGISTRO') as [Distrito_Reniec]
	  ,isnull(pos.[Tipo_Pais_Postulacion],'SIN REGISTRO') as [Tipo_Pais_Postulacion]
	  ,isnull(pos.[Pais_Postulacion],'SIN REGISTRO') as [Pais_Postulacion]
	  ,isnull(pos.[Region_Postulacion],'SIN REGISTRO') as [Departamento_Postulacion]
      ,isnull(pos.[Provincia_Postulacion],'SIN REGISTRO') as [Provincia_Postulacion]
      ,isnull(pos.[Distrito_Postulacion],'SIN REGISTRO') as [Distrito_Postulacion]
      ,isnull(pos.[Flag_Vraem],'SIN REGISTRO') as [Flag_Vraem]
      ,isnull(pos.[Estado_Postulacion],'SIN REGISTRO') as [Estado_Postulacion]
      ,isnull(pos.[Fecha_Postulacion],'01/01/1800 00:00:00') as [Fecha_Postulacion]
	  ,GETDATE() as [Fecha_Corte]
      ,isnull(pos.[Sispho_Postulacion],'SIN REGISTRO') as [Sispho_Postulacion]
      ,isnull(pos.[Estado_Validacion],'SIN REGISTRO') as [Estado_Validacion]
      ,isnull(pos.[Estado_Seleccion],'SIN REGISTRO') as [Estado_Seleccion]
      ,isnull(pos.[Estado_Aceptacion],'SIN REGISTRO') as [Estado_Aceptacion]
      ,isnull(pos.[Estado_Adjudicado],'SIN REGISTRO') as [Estado_Adjudicado]
      ,isnull(pos.[Estado_Beca],'SIN REGISTRO') as [Estado_Beca]
      ,isnull(pos.[Condicion_Beca],'SIN REGISTRO') as [Condicion_Beca]
      ,isnull(pos.[Situacion_Beca],'SIN REGISTRO') as [Situacion_Beca]
	  ,isnull(pos.[Resolucion_Beca],'SIN REGISTRO') as [Resolucion_Beca]
	  ,isnull(pos.[Fec_Resolucion_Beca],'01/01/1800 00:00:00') as [Fec_Resolucion_Beca] 
	  ,isnull(pos.[Resolucion_Beneficiario],'SIN REGISTRO') as [Resolucion_Beneficiario]
	  ,isnull(pos.[Fecha_Resolucion_Beneficiario],'01/01/1800 00:00:00') as [Fecha_Resolucion_Beneficiario] 
	  ,isnull(pos.[Resolucion_Ret_Beca],'SIN REGISTRO') as [Resolucion_Ret_Beca]
	  ,isnull(pos.[Fec_Resolucion_Ret_Beca],'01/01/1800 00:00:00') as [Fec_Resolucion_Ret_Beca] 
	  ,isnull(pos.[Resolucion_Nulidad_Beca],'SIN REGISTRO') as [Resolucion_Nulidad_Beca]
	  ,isnull(pos.[Fec_Resolucion_Nulidad_Beca],'01/01/1800 00:00:00') as [Fec_Resolucion_Nulidad_Beca] 
	  ,'NO' as [I_Becas_Otorgadas] 
  FROM [sa].[Fact_Postulaciones] pos
  left join sa.Dim_Inscripcion ins on ins.Id_Persona = pos.Id_Persona and ins.Id_Concurso = pos.Id_Concurso
  left join sa.Dim_Persona per on per.Id_Persona = pos.Id_Persona</property>
                <property
                  dataType="System.String"
                  description="Variable que contiene el comando SQL para ejecutar."
                  name="SqlCommandVariable"></property>

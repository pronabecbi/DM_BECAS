                <component
                  refId="Package\Carga Dimension Condicion Priorizable\Carga_sa_Dim_Condicion_Discapacidad_Esq_Nuevo\Origen Condicion Discapacidad Transac"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Condicion Discapacidad Transac"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">--BECAS EN ESQUEMA ANTIGUO DB_PRONABEC	
	--select 
	--cast(concat('1',po.Id_Postulacion)as int)as 'Id_Postulacion_Preadj',upper(dirtp.Nombre) tipo_comu
	--,upper(dir.Detalle) det_comunidad,dr.Descripcion region,dp.Descripcion provincia,dd.Descripcion distrito
	--,[Val_Doc_Comunidades] = ''
	--from 
	--Postulacion po
	--inner join pos_direccion_postulante dir on dir.Id_Postulacion = po.Id_Postulacion and dir.Id_Tipo in (2,6,7)
	--left join pos_direccion_tipo dirtp on dirtp.Id_Tipo = dir.Id_Tipo
	--LEFT JOIN General dd on dd.Codigo=LEFT(dir.Ubigeo, 6) and dd.Tipo_Tabla=14
	--LEFT JOIN General dp on dp.Codigo=LEFT(dir.Ubigeo, 4) and dp.Tipo_Tabla=13
	--LEFT JOIN General dr on dr.Codigo=LEFT(dir.Ubigeo, 2) and dr.Tipo_Tabla=12
	--where po.Id_Convocatoria not in (select 
	--cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int) as 'Id_Convocatoria'
	--from db_concursos.config.concurso c
	--inner join db_concursos.config.modalidad mm on mm.I_CONCURSO_ID = c.I_CONCURSO_ID)	
	--union 

	/*=====================================================BECAS EN ESQUEMA NUEVO DB_CONCURSOS=================================================*/

	/*======================================los que estan en db_concursos pero no son beca 18==================================================*/

	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	--,'X' as 'TIPO'
	,[Discapacidad] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_TIPOS
		else codi.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_1] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_UNO
		else codi_Otr1.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_2] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_DOS
		else codi_Otr2.V_CLAIM_VALOR
	end
	,[Val_Doc_Certificado_Discapacidad] = 
	CAST (case 
	when (vdd01.B_CUMPLE is null and vdd01x.B_CUMPLE is null and vdd01y.B_CUMPLE is null) then ''
	when vdd01.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01.B_CUMPLE =0  then 'NO CUMPLE'
	when vdd01x.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01x.B_CUMPLE =0  then 'NO CUMPLE' 
	when vdd01y.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01y.B_CUMPLE =0  then 'NO CUMPLE' 	
	END AS varchar(250) )  	
	--into ##temp
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID --AND conc.I_CONCURSO_ID = 37
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 3
	
	left join db_concursos.proceso.participante_claim codi WITH (NOLOCK) on codi.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi.V_CLAIM_NOMBRE IN ('DISCAPACIDAD') and codi.V_CLAIM_VALOR &lt;&gt;'180000'
	left join db_concursos.proceso.participante_claim codi_Otr1 WITH (NOLOCK) on codi_Otr1.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi_Otr1.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_UNO') 
	left join db_concursos.proceso.participante_claim codi_Otr2 WITH (NOLOCK) on codi_Otr2.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi_Otr2.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_DOS') 
	left join db_concursos.priorizable.discapacidad codip WITH (NOLOCK) on codip.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codip.V_TIPOS &lt;&gt;'180000'

	-- valida discapacidad 1
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01 on vdd01.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd01.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MIN(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	-- valida discapacidad 2
	left join db_concursos.proceso.participante_modulo parvalx  WITH (NOLOCK)on  parvalx.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parvalx.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rvalx WITH (NOLOCK) on rvalx.I_PARTICIPANTE_MOD_ID=parvalx.I_PARTICIPANTE_MOD_ID and rvalx.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01x on vdd01x.I_RESULTADO_ID=rvalx.I_RESULTADO_ID AND  vdd01x.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MAX(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)	
	--valida discapacidad 3
	left join db_concursos.proceso.participante_modulo parvaly  WITH (NOLOCK) on  parvaly.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parvaly.I_MODULO_ID=(select max(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rvaly WITH (NOLOCK) on rvaly.I_PARTICIPANTE_MOD_ID=parvaly.I_PARTICIPANTE_MOD_ID and rvaly.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01y on vdd01y.I_RESULTADO_ID=rvaly.I_RESULTADO_ID AND  vdd01y.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MIN(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select max(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID 
	and I_ETAPA_ID = 4)
	)
	where 
	UPPER(conc.V_NOMBRE) NOT LIKE '%BECA 18%'
	and md.I_ESTADO_MODULO in (102003,103003)
	and 
	(codi.I_PARTICIPANTE_ID is not null or codip.I_PARTICIPANTE_ID is not null )

	--order by par.I_PARTICIPANTE_ID desc
	union all
	
    /*===================================db_concursos Beca 18 solo 1er momento e inscripcion =========================================================*/

   select  
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	--,'Y' as 'TIPO'
	--,I_ETAPA_ID 
	--,codip.V_TIPOS
	--,codi.V_CLAIM_VALOR
	,[Discapacidad] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_TIPOS
		else codi.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_1] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_UNO
		else codi_Otr1.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_2] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_DOS
		else codi_Otr2.V_CLAIM_VALOR
	end	
	,[Val_Doc_Certificado_Discapacidad] = 
	case 
	when (vdd01.B_CUMPLE is null and vdd01x.B_CUMPLE is null) then ''
	when vdd01x.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01x.B_CUMPLE =0  then 'NO CUMPLE' 
	when vdd01.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01.B_CUMPLE =0  then 'NO CUMPLE'	
	end	
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID -- pos
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and ((I_ETAPA_ID = 3 and conc.I_ANIO &lt; 2024)or(I_ETAPA_ID in (2,3) and conc.I_ANIO &gt;= 2024))
	
	left join db_concursos.proceso.participante_claim codi WITH (NOLOCK) on codi.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi.V_CLAIM_NOMBRE IN ('DISCAPACIDAD') and codi.V_CLAIM_VALOR &lt;&gt;'180000'
	left join db_concursos.proceso.participante_claim codi_Otr1 WITH (NOLOCK) on codi_Otr1.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi_Otr1.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_UNO') 
	left join db_concursos.proceso.participante_claim codi_Otr2 WITH (NOLOCK) on codi_Otr2.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codi_Otr2.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_DOS') 
	left join db_concursos.priorizable.discapacidad codip WITH (NOLOCK) on codip.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID  and codip.V_TIPOS &lt;&gt;'180000'

	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01 on vdd01.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd01.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MIN(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	left join db_concursos.proceso.participante_modulo parvalx  WITH (NOLOCK)on  parvalx.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parvalx.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rvalx WITH (NOLOCK) on rvalx.I_PARTICIPANTE_MOD_ID=parvalx.I_PARTICIPANTE_MOD_ID and rvalx.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01x on vdd01x.I_RESULTADO_ID=rvalx.I_RESULTADO_ID AND  vdd01x.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MAX(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	) 
	where UPPER(conc.V_NOMBRE) LIKE '%BECA 18%' and mom.V_CODIGO = 'M1'	and md.I_ESTADO_MODULO in (102003,103003)
	and 
	(codi.I_PARTICIPANTE_ID is not null or codip.I_PARTICIPANTE_ID is not null )	
	union all	
	
	/*====================db_concursos solo 2do momento trayendo el dato del 1er momento (los que postularon tambien en el 1er momento)=====================*/

	select  
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	--,'Z' as 'TIPO'
	,[Discapacidad] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_TIPOS
		else codi.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_1] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_UNO
		else codi_Otr1.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_2] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_DOS
		else codi_Otr2.V_CLAIM_VALOR
	end	
	,[Val_Doc_Certificado_Discapacidad] = 
	case 
	when (vdd01.B_CUMPLE is null and vdd01x.B_CUMPLE is null) then ''
	when vdd01.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01.B_CUMPLE=0  then 'NO CUMPLE'
	when vdd01x.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01x.B_CUMPLE=0  then 'NO CUMPLE' 
	end	
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%'
	inner join
	(
		select 
		par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
		par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
		par2.I_MOMENTO_ID as 'I_MOMENTO_2',
		par1.I_MOMENTO_ID as 'I_MOMENTO_1'
		from db_concursos.proceso.participante par2
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(con.V_NOMBRE) LIKE '%BECA 18%'
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
		) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_2 = par.I_PARTICIPANTE_ID	   
	--inner join db_concursos.proceso.participante par2 on par2.V_NUM_DOCUMENTO=par.V_NUM_DOCUMENTO  --and par2.I_MOMENTO_ID=1
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 3
	
	left join db_concursos.proceso.participante_claim codi WITH (NOLOCK) on codi.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codi.V_CLAIM_NOMBRE IN ('DISCAPACIDAD') and codi.V_CLAIM_VALOR &lt;&gt;'180000'
	left join db_concursos.proceso.participante_claim codi_Otr1 WITH (NOLOCK) on codi_Otr1.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codi_Otr1.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_UNO') 
	left join db_concursos.proceso.participante_claim codi_Otr2 WITH (NOLOCK) on codi_Otr2.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codi_Otr2.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_DOS') 
	left join db_concursos.priorizable.discapacidad codip WITH (NOLOCK) on codip.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codip.V_TIPOS &lt;&gt;'180000'
	
	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01 on vdd01.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd01.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MIN(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4)
	)
	left join db_concursos.proceso.participante_modulo parvalx  WITH (NOLOCK)on  parvalx.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parvalx.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rvalx WITH (NOLOCK) on rvalx.I_PARTICIPANTE_MOD_ID=parvalx.I_PARTICIPANTE_MOD_ID and rvalx.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01x on vdd01x.I_RESULTADO_ID=rvalx.I_RESULTADO_ID AND  vdd01x.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MAX(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 
	and I_ETAPA_ID = 4)
	)
	where 
	(codi.I_PARTICIPANTE_ID is not null or codip.I_PARTICIPANTE_ID is not null )
	
	union all
	
	/*====================db_concursos solo 2do momento trayendo el dato de preseleccion (los que no postularon al 1er momento)=====================*/

	select  
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	--,'P' as 'TIPO'
	,[Discapacidad] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_TIPOS
		else codi.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_1] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_UNO
		else codi_Otr1.V_CLAIM_VALOR
	end
	,[Discapacidad_Otro_2] = 
	case 
		when (conc.I_CONCURSO_ID in (58,56) or conc.I_CONCURSO_ID &gt;= 60) then codip.V_OTRO_DOS
		else codi_Otr2.V_CLAIM_VALOR
	end	
	,[Val_Doc_Certificado_Discapacidad] = 
	case 
	when (vdd01.B_CUMPLE is null and vdd01x.B_CUMPLE is null) then ''
	when vdd01.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01.B_CUMPLE=0  then 'NO CUMPLE'
	when vdd01x.B_CUMPLE=1  then 'CUMPLE' 
	when vdd01x.B_CUMPLE=0  then 'NO CUMPLE' 
	end	
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(conc.V_NOMBRE) LIKE '%BECA 18%'
	inner join
	(
		select 
		par2.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2',
		par1.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1',
		par2.I_MOMENTO_ID as 'I_MOMENTO_2',
		par1.I_MOMENTO_ID as 'I_MOMENTO_1'
		from db_concursos.proceso.participante par2
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2.I_MOMENTO_ID and mom.V_CODIGO = 'M2'
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and UPPER(con.V_NOMBRE) LIKE '%BECA 18%'
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID
			WHERE par.I_PARTICIPANTE_ID not in
			(
			select par.I_PARTICIPANTE_ID
			from proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_CODIGO = 'M1'
			inner join proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
			inner join config.modulo modu on modu.I_MODULO_ID = parmd.I_MODULO_ID and I_ETAPA_ID = 3			
			)
		) par1 on par1.V_NUM_DOCUMENTO = par2.V_NUM_DOCUMENTO and par1.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_2 = par.I_PARTICIPANTE_ID   
	--inner join db_concursos.proceso.participante par2 on par2.V_NUM_DOCUMENTO=par.V_NUM_DOCUMENTO  --and par2.I_MOMENTO_ID=1
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = parx.I_PARTICIPANTE_ID_1 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID = 2
	
	left join db_concursos.proceso.participante_claim codi WITH (NOLOCK) on codi.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codi.V_CLAIM_NOMBRE IN ('DISCAPACIDAD') and codi.V_CLAIM_VALOR &lt;&gt;'180000'
	left join db_concursos.proceso.participante_claim codi_Otr1 WITH (NOLOCK) on codi_Otr1.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codi_Otr1.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_UNO') 
	left join db_concursos.proceso.participante_claim codi_Otr2 WITH (NOLOCK) on codi_Otr2.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codi_Otr2.V_CLAIM_NOMBRE IN ('OTRO_DISCAPACIDAD_DOS') 
	left join db_concursos.priorizable.discapacidad codip WITH (NOLOCK) on codip.I_PARTICIPANTE_ID=parx.I_PARTICIPANTE_ID_1  and codip.V_TIPOS &lt;&gt;'180000'
	
	--valida procedencia
	left join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01 on vdd01.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd01.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MIN(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4)
	)
	left join db_concursos.proceso.participante_modulo parvalx  WITH (NOLOCK)on  parvalx.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parvalx.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	left join db_concursos.validacion.resultado rvalx WITH (NOLOCK) on rvalx.I_PARTICIPANTE_MOD_ID=parvalx.I_PARTICIPANTE_MOD_ID and rvalx.B_ESTADO=1                               
    left join db_concursos.validacion.resultado_detalle vdd01x on vdd01x.I_RESULTADO_ID=rvalx.I_RESULTADO_ID AND  vdd01x.I_CARTILLA_ID IN                                                   
    (
	Select I_CARTILLA_ID
	from db_concursos.validacion.cartilla car
	inner join 
		(	
			(
			Select I_MODULO_ID,MAX(I_ORDEN) AS I_ORDEN
			from db_concursos.validacion.cartilla 
			where I_DOCUMENTACION_ID = 120011 
			group by I_MODULO_ID
			)
		) ord on ord.I_ORDEN = car.I_ORDEN and ord.I_MODULO_ID = car.I_MODULO_ID
	where I_DOCUMENTACION_ID = 120011 
	--and V_CODIGO='R001' 
	and car.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = parx.I_MOMENTO_1 
	and I_ETAPA_ID = 4)
	)
	where 
	(codi.I_PARTICIPANTE_ID is not null or codip.I_PARTICIPANTE_ID is not null )</property>

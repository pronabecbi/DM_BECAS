            <component
              refId="Package\Carga_sa_Dim_Inscripcion_Esq_Nuev\Origen Inscripciones Transac Esq Nuev"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen Inscripciones Transac Esq Nuev"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select 
CONCAT(2,par.I_PARTICIPANTE_ID) as 'I_PARTICIPANTE_ID_PREADJ',
par.I_PERSONA_ID as 'Id_Persona',
cast(substring (mm.V_CONFIGURACION, CHARINDEX('toriaId',mm.V_CONFIGURACION)+9,3)as Int) as 'Id_Convocatoria',
con.I_CONCURSO_ID as 'Id_Concurso',
cast(edab.V_CLAIM_VALOR as varchar(500)) as 'Edad_Bases',
cast(regrn.V_NOMBRE as varchar(500)) as 'Region_Reniec',
cast(prvrn.V_NOMBRE as varchar(500)) as 'Provincia_Reniec',
cast(dstrn.V_NOMBRE as varchar(500)) as 'Distrito_Reniec',
[Tipo_Pais_Inscripcion]=ISNULL(CASE WHEN regdap.V_CODIGO &lt; 26 THEN 'NACIONAL' WHEN regdap.V_CODIGO &gt; 25 THEN 'INTERNACIONAL' ELSE 'NO REGISTRADO' END,'NO REGISTRADO'),
[Pais_Inscripcion]=ISNULL(CASE WHEN regdap.V_CODIGO &lt; 26 THEN 'PERU' ELSE regdap.V_NOMBRE END,'NO REGISTRADO'),
[Region_Inscripcion]=regdap.V_NOMBRE,                                  
[Provincia_Inscripcion]=prvdap.V_NOMBRE,                                  
[Distrito_Inscripcion]=dstdap.V_NOMBRE,
cast(CASE WHEN vrm.B_VRAEM_RENIEC = '1' THEN 'VRAEM' WHEN vrm.B_VRAEM_RENIEC = '0' THEN 'NO VRAEM' ELSE 'SIN REGISTRO' END as varchar(500)) as 'FLAG_VRAEM',
(select cenu.V_NOMBRE from config.estado cenu where cenu.I_ESTADO_ID = mdlps.I_ESTADO_MODULO) as 'Estado_Inscripcion',
[Fecha_Inscripcion] = mdlps.D_TERMINO,
--cast(isnull(cosf2.V_CLAIM_VALOR,'SIN REGISTRO')as varchar(500)) as 'Sispho_Inscripcion',
cast(isnull(cosf2.V_CSE_CATEGORIA,'SIN REGISTRO')as varchar(500)) as 'Sispho_Inscripcion',
nrval.V_CODIGO as 'Estado_Validacion',
[Preseleccion]=case when parrv.I_ESTADO_MODULO='111001' THEN 'PRESELECCIONADO' ELSE null END,
[Resolucion_Preseleccion] = case when parrv.I_ESTADO_MODULO='111001' THEN parrv.V_USR_REGISTRO ELSE null END
from proceso.participante par
inner join proceso.participante_modulo mdlps WITH (NOLOCK) on par.I_PARTICIPANTE_ID = mdlps.I_PARTICIPANTE_ID and mdlps.I_ESTADO_MODULO in (102003,102002)
and mdlps.I_MODULO_ID = (select I_MODULO_ID from config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 2) --automatizar
inner join config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
inner join config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and con.I_BECA_ID not in (48, 46, 37, 36, 32)
left join proceso.participante_claim edab  WITH (NOLOCK) on  edab.V_CLAIM_NOMBRE='EDAD_BASES' and edab.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID
left join proceso.participante_modalidad mo WITH (NOLOCK) on mo.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
left join config.modalidad mm on mm.I_MODALIDAD_ID = mo.I_MODALIDAD_ID
left join proceso.participante_claim corn WITH (NOLOCK) on  corn.V_CLAIM_NOMBRE='DOM_RENIEC' and corn.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID
left join config.enumerado regrn on regrn.I_TIPO_ENUMERADO_ID=19 and regrn.V_CODIGO=LEFT(corn.V_CLAIM_VALOR,2)                        
left join config.enumerado prvrn on prvrn.I_TIPO_ENUMERADO_ID=20 and prvrn.V_CODIGO=LEFT(corn.V_CLAIM_VALOR,4)                        
left join config.enumerado dstrn on dstrn.I_TIPO_ENUMERADO_ID=21 and dstrn.V_CODIGO=corn.V_CLAIM_VALOR                      
left join db_concursos.datos.direccion pardap WITH (NOLOCK) on pardap.I_DIRECCION_ID='140001' and pardap.I_PARTICIPANTE_MOD_ID=mdlps.I_PARTICIPANTE_MOD_ID                                  
left join db_concursos.config.enumerado regdap on regdap.I_TIPO_ENUMERADO_ID=19 and regdap.V_CODIGO=LEFT(pardap.V_UBIGEO,2)                                  
left join db_concursos.config.enumerado prvdap on prvdap.I_TIPO_ENUMERADO_ID=20 and prvdap.V_CODIGO=LEFT(pardap.V_UBIGEO,4)                                  
left join db_concursos.config.enumerado dstdap on dstdap.I_TIPO_ENUMERADO_ID=21 and dstdap.V_CODIGO=pardap.V_UBIGEO 
left join datos.vraem_huallaga vrm WITH (NOLOCK) on vrm.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
--left join proceso.participante_claim cosf2 on cosf2.V_CLAIM_NOMBRE='SISFOH' and cosf2.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID
left join vulnerabilidad.clasificacion_se cosf2 WITH (NOLOCK) on cosf2.I_PARTICIPANTE_MOD_ID = mdlps.I_PARTICIPANTE_MOD_ID
left join proceso.participante_modulo parval WITH (NOLOCK) on  parval.I_PARTICIPANTE_ID=mdlps.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar     
left join validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1
--left join proceso.participante_claim clmvrm on clmvrm.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID and clmvrm.V_CLAIM_NOMBRE = 'VRAEM'
left join config.enumerado nrval on nrval.I_ENUMERADO_ID=rval.I_RESULTADO 
left join db_concursos.proceso.participante_modulo  parrv WITH (NOLOCK) on  parrv.I_PARTICIPANTE_ID=par.I_PARTICIPANTE_ID 
and parrv.I_MODULO_ID=(select I_MODULO_ID from config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 11 and V_NOMBRE = 'Etapa de preselección') --automatizar</property>
                <property
                  dataType="System.String"
                  description="Variable que contiene el comando SQL para ejecutar."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Fuerza el uso del valor de la propiedad DefaultCodePage al describir datos de caracteres."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Especifica el modo utilizado para obtener acceso a la base de datos."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="Asignaciones entre los parámetros del comando SQL y las variables."
                  name="ParameterMapping"></property>
              </properties>

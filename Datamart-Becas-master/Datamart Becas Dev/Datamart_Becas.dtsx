                <component
                  refId="Package\Carga Dimension Institucion Origen\Carga_sa_Dim_Institucion_Origen_Esq_Ant\Origen Transac Institucion_Origen_Esq_Ant"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Transac Institucion_Origen_Esq_Ant"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">--TRASLADO 2020
select [Id_Postulacion_Preadj] = concat(1,pos.Id_Postulacion)
,[Id_Institucion]= isnull((select DISTINCT I_INSTITUCION_ID from pos_data_ies_origen where LEFT(V_CODIGO,3)= mtio.V_META_VALUE ),9999999)    --  mtio.V_META_KEY='pos_ie_origen'    
,[Nombre_Institucion]= (select DISTINCT V_NOMBRE_IE from pos_data_ies_origen where LEFT(V_CODIGO,3)= mtio.V_META_VALUE )    --  mtio.V_META_KEY='pos_ie_origen'    
,[Nombre_Sede]= ISNULL((SELECT DISTINCT V_NOMBRE_SEDE FROM  pos_data_ies_origen  WHERE LEFT(V_CODIGO,3)= mtio.V_META_VALUE AND RIGHT(V_CODIGO,3)= mtso.V_META_VALUE),'SIN REGISTRO')    --mtso.V_META_KEY='pos_sede_origen'    
,[Nombre_Carrera] = mtco.V_META_VALUE    --  mtco.V_META_KEY='pos_carrera_origen'      
,[Regimen_Estudio]= UPPER(mtrg.V_META_VALUE)   --  mtrg.V_META_KEY='pos_regimen'     
,[Rendimiento]=  UPPER(case when mtrd.V_META_VALUE=1 then 'Primer y segundo puesto'   when mtrd.V_META_VALUE=2 then 'Medio superior'  when mtrd.V_META_VALUE=3 then 'Tercio superior'   
when mtrd.V_META_VALUE=5 then 'Quinto superior'  when mtrd.V_META_VALUE=10 then 'Decimo superior' end )  --  mtrd.V_META_KEY='pos_rendimiento'     
,[Duracion]=null
,[Matriculas]=null
,[Semestre]= mtsm.V_META_VALUE
FROM db_pronabec.dbo.Postulacion pos    
 inner join db_pronabec.dbo.Convocatoria con on pos.Id_Convocatoria = con.Id_Convocatoria                
 left join Postulacion_Metadata mtio on mtio.I_POSTULACION_ID=pos.Id_Postulacion and mtio.V_META_KEY='pos_ie_origen'        
 left join Postulacion_Metadata mtso on mtso.I_POSTULACION_ID=pos.Id_Postulacion and mtso.V_META_KEY='pos_sede_origen'        
 left join Postulacion_Metadata mtco on mtco.I_POSTULACION_ID=pos.Id_Postulacion and mtco.V_META_KEY='pos_carrera_origen'     
 left join Postulacion_Metadata mtrg on mtrg.I_POSTULACION_ID=pos.Id_Postulacion and mtrg.V_META_KEY='pos_regimen'        
 left join Postulacion_Metadata mtrd on mtrd.I_POSTULACION_ID=pos.Id_Postulacion and mtrd.V_META_KEY='pos_rendimiento'   
 left join Postulacion_Metadata mtsm on mtsm.I_POSTULACION_ID=pos.Id_Postulacion and mtsm.V_META_KEY='pos_ultimo_periodo'   
 WHERE  con.Id_Convocatoria in (274,275,285) and pos.Id_Estado = 2679
 union all

--CONTINUIDAD / HIJO DOCENTE / DEPORTE / TALENTO / INCLUSION CARRERAS UNIVE 2020
select 
[Id_Postulacion_Preadj] = concat(1,pos.Id_Postulacion)
,[Id_Institucion] = isnull(ieori.Id_InstitucionEducativa,ies.Id_InstitucionEducativa)
,[Nombre_Institucion] = isnull(ieori.Nombre_Institucion,ies.Nombre_Institucion)
,[Nombre_Sede] = isnull(ieori.Nombre_Sede,Sed.Nombre_Sede)
,[Nombre_Carrera] = isnull(ieori.Nombre_Carrera,car.Descripcion)
,[Regimen_Estudio]= case when con.Id_Convocatoria = 278 then mtrghd.V_META_VALUE else  mtrg.V_META_VALUE end --  mtrg.V_META_KEY='pos_regimen'     
,[Rendimiento]=  upper(case when mtrd.V_META_VALUE=1 then 'Primer y segundo puesto'   when mtrd.V_META_VALUE=2 then 'Medio superior'  when mtrd.V_META_VALUE=3 then 'Tercio superior'   
when mtrd.V_META_VALUE=5 then 'Quinto superior'  when mtrd.V_META_VALUE=10 then 'Decimo superior' end)   --  mtrd.V_META_KEY='pos_rendimiento'     
,[Duracion]=null
,[Matriculas]=null
,[Semestre_Declarado]= case when con.Id_Convocatoria = 278 then mtrsmhd.V_META_VALUE 
when con.Id_Convocatoria in (279,283) then mtrsm.V_META_VALUE
else null
end
FROM db_pronabec.dbo.Postulacion pos    
 inner join db_pronabec.dbo.Convocatoria con on pos.Id_Convocatoria = con.Id_Convocatoria  
 left join Institucion ies on ies.Id_InstitucionEducativa = pos.Id_InstitucionEducativa
 left join Institucion_Sede Sed on Sed.Id_InstitucionSede = pos.Id_InstitucionSede
 left join Carrera car on car.Id_Carrera = pos.Id_Carrera
-- left join Postulacion_Metadata mtrg on mtrg.I_POSTULACION_ID=pos.Id_Postulacion and mtrg.V_META_KEY in ('ce_regimen','hd_regimen','eil_regimen' )
 left join Postulacion_Metadata mtrg on mtrg.I_POSTULACION_ID=pos.Id_Postulacion and mtrg.V_META_KEY in ('ce_regimen','eil_regimen','bip_regimen')
 left join Postulacion_Metadata mtrghd on mtrghd.I_POSTULACION_ID=pos.Id_Postulacion and mtrghd.V_META_KEY in ('hd_regimen')
 left join Postulacion_Metadata mtrsm on mtrsm.I_POSTULACION_ID=pos.Id_Postulacion and mtrsm.V_META_KEY in ('eil_periodo_inicio')
 left join Postulacion_Metadata mtrsmhd on mtrsmhd.I_POSTULACION_ID=pos.Id_Postulacion and mtrsmhd.V_META_KEY in ('hd_periodo_inicio')
  left join Postulacion_Metadata mtrd on mtrd.I_POSTULACION_ID=pos.Id_Postulacion and mtrd.V_META_KEY='ce_orden_merito'
 left join
 (
	select hist.Id_Postulacion,ies.Id_InstitucionEducativa,ies.Nombre_Institucion,Sed.Nombre_Sede,car.Descripcion as Nombre_Carrera
	from S_Historico_Carrera hist
	inner join 
	(
		select 
		Id_Postulacion,
		min(Fecha_Reg) as Camb_1
		from S_Historico_Carrera
		where Estado = 1
		group by Id_Postulacion
	) hist1 on hist1.Id_Postulacion = hist.Id_Postulacion and hist1.Camb_1 = hist.Fecha_Reg
	inner join Institucion ies on ies.Id_InstitucionEducativa = hist.Id_Institucion_Inicio
	inner join Institucion_Sede Sed on Sed.Id_InstitucionSede = hist.Id_Sede_Inicio
	inner join Carrera car on car.Id_Carrera = hist.Id_Carrera_Inicio
 )ieori on ieori.Id_Postulacion = pos.Id_Postulacion
 WHERE  con.Id_Convocatoria in (284,278,279,283,295) and pos.Id_Estado = 2679
 union all 
--CONTINUIDAD 2020 2
select 
[Id_Postulacion_Preadj] = concat(1,pos.Id_Postulacion)
,[Id_Institucion] = isnull(ieori.Id_InstitucionEducativa,ies.Id_InstitucionEducativa)
,[Nombre_Institucion] = isnull(ieori.Nombre_Institucion,ies.Nombre_Institucion)
,[Nombre_Sede] = isnull(ieori.Nombre_Sede,Sed.Nombre_Sede)
,[Nombre_Carrera] = isnull(ieori.Nombre_Carrera,car.Descripcion)
,[Regimen_Estudio]= mtrg.V_META_VALUE --  mtrg.V_META_KEY='pos_regimen'     
,[Rendimiento]=  case mtrd.V_META_VALUE when 1 then 'PRIMEROS PUESTOS' when 10 then 'DÉCIMO PUESTO' when 5 then 'QUINTO SUPERIOR' when 4 then 'CUARTO SUPERIOR' when 3 then 'TERCIO SUPERIOR' when 2 then 'MEDIO SUPERIOR' ELSE '' end    --  mtrd.V_META_KEY='pos_rendimiento'     
,[Duracion]=mtpd.V_META_VALUE
,[Matriculas]=mtpm.V_META_VALUE
,[Semestre_Declarado]= case when con.Id_Convocatoria = 289 then mtpsm.V_META_VALUE 
else null
end
FROM db_pronabec.dbo.Postulacion pos    
 inner join db_pronabec.dbo.Convocatoria con on pos.Id_Convocatoria = con.Id_Convocatoria  
 left join Institucion ies on ies.Id_InstitucionEducativa = pos.Id_InstitucionEducativa
 left join Institucion_Sede Sed on Sed.Id_InstitucionSede = pos.Id_InstitucionSede
 left join Carrera car on car.Id_Carrera = pos.Id_Carrera
-- left join Postulacion_Metadata mtrg on mtrg.I_POSTULACION_ID=pos.Id_Postulacion and mtrg.V_META_KEY in ('ce_regimen','hd_regimen','eil_regimen' )
 left join Postulacion_Metadata mtrg on mtrg.I_POSTULACION_ID=pos.Id_Postulacion and mtrg.V_META_KEY = 'ce2_regimen'
 left join Postulacion_Metadata mtrd on mtrd.I_POSTULACION_ID=pos.Id_Postulacion and mtrd.V_META_KEY='ce2_orden_merito'
 left join Postulacion_Metadata mtpm on mtpm.I_POSTULACION_ID=pos.Id_Postulacion and mtpm.V_META_KEY='ce2_periodo_matriculado'
 left join Postulacion_Metadata mtpd on mtpd.I_POSTULACION_ID=pos.Id_Postulacion and mtpd.V_META_KEY='ce2_periodos_duracion'
 left join Postulacion_Metadata mtpsm on mtpsm.I_POSTULACION_ID=pos.Id_Postulacion and mtpsm.V_META_KEY='ce2_ultimo_periodo'
 left join
 (
	select hist.Id_Postulacion,ies.Id_InstitucionEducativa,ies.Nombre_Institucion,Sed.Nombre_Sede,car.Descripcion as Nombre_Carrera
	from S_Historico_Carrera hist
	inner join 
	(
		select 
		Id_Postulacion,
		min(Fecha_Reg) as Camb_1
		from S_Historico_Carrera
		where Estado = 1
		group by Id_Postulacion
	) hist1 on hist1.Id_Postulacion = hist.Id_Postulacion and hist1.Camb_1 = hist.Fecha_Reg
	inner join Institucion ies on ies.Id_InstitucionEducativa = hist.Id_Institucion_Inicio
	inner join Institucion_Sede Sed on Sed.Id_InstitucionSede = hist.Id_Sede_Inicio
	inner join Carrera car on car.Id_Carrera = hist.Id_Carrera_Inicio
 )ieori on ieori.Id_Postulacion = pos.Id_Postulacion
 WHERE  con.Id_Convocatoria in (288,289) and pos.Id_Estado = 2679</property>
                    <property
                      dataType="System.String"
                      description="Variable que contiene el comando SQL para ejecutar."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos."
                      name="DefaultCodePage">1252</property>

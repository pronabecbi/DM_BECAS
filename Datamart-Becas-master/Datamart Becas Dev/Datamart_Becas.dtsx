                <component
                  refId="Package\Carga Dimension Persona\Carga_ods_Dim_Persona\Origen Persona SA"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Persona SA"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
	   [Id_Persona]
      ,[Apellido_Paterno]
      ,[Apellido_Materno]
      ,[Nombres]
      ,ISNULL([Tipo_Documento],'SIN REGISTRO') AS 'Tipo_Documento'
      ,[Nro_Documento]
      ,ISNULL([Fecha_Nacimiento],'01/01/01') as 'Fecha_Nacimiento'
	  ,[Edad_Actual] =  ISNULL(CAST(ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) AS int),999) 
	  ,[Rango_Edad] =
		 case 
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 0 and 14 THEN '0-14'
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 15 and 16 THEN '15-16'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 17 and 18 THEN '17-18'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 19 and 22 THEN '19-22'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 23 and 30 then '23-30'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 31 and 40 then '31-40'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 41 and 50 then '41-50'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) between 51 and 60 then '51-60'                                              
		  when  ods.ufnCalcularEdad(Fecha_Nacimiento, GETDATE()) &gt;= 61  then '61 A MAS'
		  else 'SIN REGISTRO' END
      ,[Sexo]
      ,CAST(ISNULL([Departamento_Nacimiento],'SIN REGISTRO')AS VARCHAR(150)) AS 'Departamento_Nacimiento'
      ,CAST(ISNULL([Provincia_Nacimiento],'SIN REGISTRO')AS VARCHAR(150)) AS 'Provincia_Nacimiento'
	  ,CAST(ISNULL([Departamento_RENIEC],'SIN REGISTRO')AS VARCHAR(200)) AS 'Departamento_RENIEC'
      ,CAST(ISNULL([Provincia_RENIEC],'SIN REGISTRO')AS VARCHAR(200)) AS 'Provincia_RENIEC'
	  ,CAST(ISNULL([Distrito_RENIEC],'SIN REGISTRO')AS VARCHAR(200)) AS 'Distrito_RENIEC'
      ,ISNULL([Lengua_Materna],'SIN REGISTRO') AS 'Lengua_Materna'
      ,ISNULL(CAST([Promedio_Secundaria] AS VARCHAR(150)),'SIN REGISTRO') as 'Promedio_Secundaria'
	  ,NULL as 'Nro_Postulaciones'
	  ,ISNULL([telefono_celular],'SIN REGISTRO') AS 'telefono_celular'
	  ,ISNULL([Email],'SIN REGISTRO') AS 'Email'
  FROM [sa].[Dim_Persona]</property>
                    <property
                      dataType="System.String"
                      description="Variable que contiene el comando SQL para ejecutar."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Especifica la página de códigos de columna para utilizar cuando la información de página de códigos no está disponible en el origen de datos."
                      name="DefaultCodePage">1252</property>
                    <property

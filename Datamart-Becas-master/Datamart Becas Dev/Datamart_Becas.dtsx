                </component>
                <component
                  refId="Package\Carga Dimension Condicion Priorizable\Carga_sa_Dim_Condicion_Bomb EsqNuev\Origen Condicion Bomb Transac"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="Origen Condicion Bomb Transac"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="Comando SQL para ejecutar."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">--BECAS EN ESQUEMA NUEVO DB_CONCURSOS	

	--(BHD CONVOCATORIAS DEL 2021 AL 2023) Y TODAS DISTINTAS A B18 Y BHD
	--( PARA BHD CONV 2021 2022 2023: COMO EL I_PARTICIPANTE_ID EN 1 MOMENTO ES EL MISMO QUE PRESELECCION 
	--, YA SE ESTARÍA CUBRIENDO BHD CONV 2021 2022 2023 1ER MOMENTO ]
	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	,[Declara_Bombero]= 'SI'
	,[Valida_Bombero] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID -- pos
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID in (2,3)
	--valida procedencia
	inner join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	inner join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	inner join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID in (120012,120093) 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	where 
	(
		(conc.I_BECA_ID = 14 and conc.I_ANIO in (2021,2022,2023)) -- BHD DEL 2021 AL 2023 
		or (conc.I_BECA_ID not in (1,14)) -- TODAS MENOS BHD Y B18
	)
	and md.I_ESTADO_MODULO in (102003,103003)
	
	union all

	--BHD CONVOCATORIAS 2024 EN ADELANTE Y BECA 18 (PRESELECCION)
	--( PARA B18 CONV 2021 2022 2023: COMO EL I_PARTICIPANTE_ID EN 1 MOMENTO ES EL MISMO QUE PRESELECCION 
	--, YA SE ESTARÍA CUBRIENDO B18 CONV 2021 2022 2023 1ER MOMENTO ]
	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',par.I_PARTICIPANTE_ID)as int) as 'Id_Postulacion_Preadj'
	,[Declara_Bombero]= 'SI'
	,[Valida_Bombero] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID in (2) -- PRESELECCION
	--valida procedencia
	inner join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	inner join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	inner join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID in (120012,120093) 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	where 
	(
		(conc.I_BECA_ID = 14 and conc.I_ANIO &gt;= 2024) -- BHD 2024 EN ADELANTE PRESELECCION 
		or (conc.I_BECA_ID = 1) -- B18 PRESELECCION
	)
	and md.I_ESTADO_MODULO in (102003)

	union all

	--BHD y B18 CONVOCATORIAS 2024 EN ADELANTE (POSTULACION - M1)	
	-- DONDE EL I_PARTICIPANTE_ID HA CAMBIADO
	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',parx.I_PARTICIPANTE_ID_1_SEL)as int) as 'Id_Postulacion_Preadj'
	,[Declara_Bombero]= 'SI'
	,[Valida_Bombero] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID in (2) -- PRESELECCION
	--valida procedencia
	inner join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	inner join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	inner join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID in (120012,120093) 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	inner join
	(
		--B18
		select 
		par1sel.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1_SEL',
		par1prsl.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1_PRSEL',
		par1sel.I_MOMENTO_ID as 'I_MOMENTO_1_SEL',
		par1prsl.I_MOMENTO_ID as 'I_MOMENTO_1_PRSEL'
		from db_concursos.proceso.participante par1sel
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par1sel.I_MOMENTO_ID and mom.V_NOMBRE = 'Primer momento' --and mom.V_CODIGO IN ('M1')
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and I_BECA_ID IN (1) AND con.I_ANIO &gt;= 2024
		INNER JOIN db_concursos.proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par1sel.I_PARTICIPANTE_ID
		INNER JOIN db_concursos.config.modulo md on md.I_MODULO_ID = parmd.I_MODULO_ID and md.I_ETAPA_ID = 3
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_NOMBRE = 'Preseleccion' --and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and I_BECA_ID IN (1) AND con.I_ANIO &gt;= 2024
			INNER JOIN db_concursos.proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
			INNER JOIN db_concursos.config.modulo md on md.I_MODULO_ID = parmd.I_MODULO_ID and md.I_ETAPA_ID = 2
		) par1prsl on par1prsl.V_NUM_DOCUMENTO = par1sel.V_NUM_DOCUMENTO and par1prsl.I_CONCURSO_ID = con.I_CONCURSO_ID
		union all
		--BHD
		select 
		par1sel.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1_SEL',
		par1prsl.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1_PRSEL',
		par1sel.I_MOMENTO_ID as 'I_MOMENTO_1_SEL',
		par1prsl.I_MOMENTO_ID as 'I_MOMENTO_1_PRSEL'
		from db_concursos.proceso.participante par1sel
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par1sel.I_MOMENTO_ID and mom.V_NOMBRE = 'Momento único' and mom.V_CODIGO IN ('M1')
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and I_BECA_ID IN (14) AND con.I_ANIO &gt;= 2024
		INNER JOIN db_concursos.proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par1sel.I_PARTICIPANTE_ID
		INNER JOIN db_concursos.config.modulo md on md.I_MODULO_ID = parmd.I_MODULO_ID and md.I_ETAPA_ID = 3
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID and mom.V_NOMBRE = 'Momento único' and mom.V_CODIGO IN ('M2')
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and I_BECA_ID IN (14) AND con.I_ANIO &gt;= 2024
			INNER JOIN db_concursos.proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
			INNER JOIN db_concursos.config.modulo md on md.I_MODULO_ID = parmd.I_MODULO_ID and md.I_ETAPA_ID = 2
		) par1prsl on par1prsl.V_NUM_DOCUMENTO = par1sel.V_NUM_DOCUMENTO and par1prsl.I_CONCURSO_ID = con.I_CONCURSO_ID
	) parx on parx.I_PARTICIPANTE_ID_1_PRSEL = par.I_PARTICIPANTE_ID
	where 
	(
		(conc.I_BECA_ID = 14 and conc.I_ANIO &gt;= 2024) -- BHD 2024 EN ADELANTE SELECCION 
		or (conc.I_BECA_ID = 1 and conc.I_ANIO &gt;= 2024) -- B18 SELECCION
	)
	and md.I_ESTADO_MODULO in (102003)

	union all

	-- B18 CONVOCATORIAS 2024 EN ADELANTE (POSTULACION - M2)	
	-- DONDE EL I_PARTICIPANTE_ID HA CAMBIADO
	select  --dd.Descripcion,dp.Descripcion,dr.Descripcion,dir.*,dirtp.*
	cast(concat('2',parx.I_PARTICIPANTE_ID_2_SEL)as int) as 'Id_Postulacion_Preadj'
	,[Declara_Bombero]= 'SI'
	,[Valida_Bombero] = case when vdd13.B_CUMPLE is null  then ''when vdd13.B_CUMPLE=1  then 'CUMPLE' when vdd13.B_CUMPLE =0  then 'NO CUMPLE' END
	from db_concursos.proceso.participante par
	inner join db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID 
	inner join db_concursos.config.concurso conc on conc.I_CONCURSO_ID = mom.I_CONCURSO_ID and conc.I_BECA_ID not in (46, 37, 36, 32)
	inner join db_concursos.proceso.participante_modulo md on md.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID 
	inner join db_concursos.config.modulo mdl on mdl.I_MODULO_ID = md.I_MODULO_ID and I_ETAPA_ID in (2) -- PRESELECCION
	--valida procedencia
	inner join db_concursos.proceso.participante_modulo parval  WITH (NOLOCK)on  parval.I_PARTICIPANTE_ID=md.I_PARTICIPANTE_ID and parval.I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4) -- automatizar             --MODULO_VALIDACION      
	inner join db_concursos.validacion.resultado rval WITH (NOLOCK) on rval.I_PARTICIPANTE_MOD_ID=parval.I_PARTICIPANTE_MOD_ID and rval.B_ESTADO=1                               
	inner join db_concursos.validacion.resultado_detalle vdd13 on vdd13.I_RESULTADO_ID=rval.I_RESULTADO_ID AND  vdd13.I_CARTILLA_ID IN                                                   
	(
	Select I_CARTILLA_ID 
	from db_concursos.validacion.cartilla 
	where I_DOCUMENTACION_ID in (120012,120093) 	
	and I_MODULO_ID=(select min(I_MODULO_ID) from db_concursos.config.modulo where I_MOMENTO_ID = par.I_MOMENTO_ID and I_ETAPA_ID = 4)
	)
	inner join
	(
		--B18
		select 
		par2sel.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_2_SEL',
		par1prsl.I_PARTICIPANTE_ID as 'I_PARTICIPANTE_ID_1_PRSEL',
		par2sel.I_MOMENTO_ID as 'I_MOMENTO_2_SEL',
		par1prsl.I_MOMENTO_ID as 'I_MOMENTO_1_PRSEL'
		from db_concursos.proceso.participante par2sel
		INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par2sel.I_MOMENTO_ID and mom.V_NOMBRE = 'Segundo momento' --and mom.V_CODIGO IN ('M1')
		INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and I_BECA_ID IN (1) AND con.I_ANIO &gt;= 2024
		INNER JOIN db_concursos.proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par2sel.I_PARTICIPANTE_ID
		INNER JOIN db_concursos.config.modulo md on md.I_MODULO_ID = parmd.I_MODULO_ID and md.I_ETAPA_ID = 3
		INNER JOIN
		(
			select par.*,con.I_CONCURSO_ID,con.I_ANIO
			from db_concursos.proceso.participante par
			INNER JOIN db_concursos.config.momento mom on mom.I_MOMENTO_ID = par.I_MOMENTO_ID  and mom.V_NOMBRE = 'Preseleccion' --and mom.V_CODIGO = 'M1'
			INNER JOIN db_concursos.config.concurso con on con.I_CONCURSO_ID = mom.I_CONCURSO_ID and I_BECA_ID IN (1) AND con.I_ANIO &gt;= 2024
			INNER JOIN db_concursos.proceso.participante_modulo parmd on parmd.I_PARTICIPANTE_ID = par.I_PARTICIPANTE_ID
			INNER JOIN db_concursos.config.modulo md on md.I_MODULO_ID = parmd.I_MODULO_ID and md.I_ETAPA_ID = 2
		) par1prsl on par1prsl.V_NUM_DOCUMENTO = par2sel.V_NUM_DOCUMENTO and par1prsl.I_CONCURSO_ID = con.I_CONCURSO_ID		
	) parx on parx.I_PARTICIPANTE_ID_1_PRSEL = par.I_PARTICIPANTE_ID
	where 
	(
		(conc.I_BECA_ID = 1 and conc.I_ANIO &gt;= 2024) -- B18 SELECCION
	)
	and md.I_ESTADO_MODULO in (102003)</property>
                    <property
